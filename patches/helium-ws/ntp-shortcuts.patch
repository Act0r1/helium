 #include <algorithm>
+#include <string>
 #include <vector>
 
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
 #include "url/gurl.h"
 
 namespace ntp_tiles::custom_links_util {
 
+inline std::string GetSiteKey(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return url.spec();
+  }
+  std::string host = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  if (host.empty()) {
+    host = url.host();
+  }
+  if (host.ends_with('.')) {
+    host.pop_back();
+  }
+  return host;
+}
+
 // Moves the specified link from its current index and inserts it at
 // |new_pos|. Returns false and does nothing if |url| is invalid, |url| does not
 // exist in the list, or |new_pos| is invalid/already the current index.
