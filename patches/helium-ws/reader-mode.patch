+
+// Shows the estimated reading time and a link back to the original page.
+function showArticleMeta() {
+  const originalUrl = new URLSearchParams(location.search).get('url');
+  const words = $('content').innerText.split(/\s+/).filter(Boolean).length;
+  const minutes = Math.max(1, Math.round(words / 230));
+  $('reading-time').textContent = minutes + ' min. read';
+  if (originalUrl && /^https?:/.test(originalUrl)) {
+    $('view-original').href = originalUrl;
+  } else {
+    $('view-original').remove();
+  }
+  $('article-meta').hidden = false;
 }
 
