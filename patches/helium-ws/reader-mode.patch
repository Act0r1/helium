@@ -69,6 +69,83 @@ function addToPage(html) {
 
 function showLoadingIndicator(isLastPage) {
   $('loading-indicator').className = isLastPage ? 'hidden' : 'visible';
+  if (isLastPage) {
+    showArticleMeta();
+  }
+}
+
+const WORDS_PER_MINUTE = 230;
+let articleWordCount = 0;
+let lastScrollY = 0;
+
+// Shows the estimated reading time under the title.
+function showArticleMeta() {
+  articleWordCount =
+      $('content').innerText.split(/\s+/).filter(Boolean).length;
+  $('article-meta').hidden = false;
+  updateReadingProgress();
+}
+
+// Updates the progress bar and the time left, and hides the toolbar while
+// scrolling down and shows it while scrolling up.
+function updateReadingProgress() {
+  const y = window.scrollY;
+  const max = document.documentElement.scrollHeight - window.innerHeight;
+  const progress = max > 0 ? Math.min(1, y / max) : 0;
+  $('reading-progress-bar').style.width = progress * 100 + '%';
+
+  const toolbar = $('reader-toolbar');
+  const hide = y > lastScrollY && y > 80 &&
+      !toolbar.contains(document.activeElement);
+  toolbar.classList.toggle('toolbar-hidden', hide);
+  lastScrollY = y;
+
+  if (!articleWordCount) {
+    return;
+  }
+  const total = Math.max(1, Math.round(articleWordCount / WORDS_PER_MINUTE));
+  const left = Math.ceil(articleWordCount * (1 - progress) / WORDS_PER_MINUTE);
+  let text = total + ' min. read';
+  if (y > 40) {
+    text = left > 0 ? left + ' min. left' : 'Finished';
+  }
+  $('reading-time').textContent = text;
+}
+
+// Returns to the original page.
+function closeReader() {
+  const originalUrl = new URLSearchParams(location.search).get('url');
+  if (history.length > 1) {
+    history.back();
+  } else if (originalUrl && /^https?:/.test(originalUrl)) {
+    location.href = originalUrl;
+  }
+}
+
+// Esc closes the reader, +/- change the font size, T switches the theme.
+function handleReaderKeys(event) {
+  if (event.ctrlKey || event.metaKey || event.altKey ||
+      event.target.isContentEditable ||
+      ['INPUT', 'TEXTAREA', 'SELECT'].includes(event.target.tagName)) {
+    return;
+  }
+  const key = event.key.toLowerCase();
+  if (key === 'escape') {
+    closeReader();
+  } else if (key === '+' || key === '=') {
+    FontSizeSlider.getInstance().step(1);
+  } else if (key === '-') {
+    FontSizeSlider.getInstance().step(-1);
+  } else if (event.code === 'KeyT') {
+    const order = ['light', 'sepia', 'dark'];
+    const next = order[(order.indexOf(getAppearanceSetting(themeClasses)) + 1) %
+                       order.length];
+    useTheme(next);
+    distiller.storeThemePref(themeClasses.indexOf(next));
+  } else {
+    return;
+  }
+  event.preventDefault();
 }
 
