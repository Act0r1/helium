+#ifndef CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_SEARCH_ENGINE_CHIP_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_SEARCH_ENGINE_CHIP_VIEW_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/menus/simple_menu_model.h"
+#include "ui/views/controls/button/button.h"
+
+class OmniboxController;
+
+namespace gfx {
+class Image;
+}  // namespace gfx
+
+namespace views {
+class ImageView;
+class MenuRunner;
+}  // namespace views
+
+// Pill with the default search engine icon and a chevron, shown in the location
+// bar while the omnibox popup is open. Its menu lists the search engines;
+// choosing one starts a one-off search with it in keyword mode.
+class SearchEngineChipView : public views::Button,
+                             public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(SearchEngineChipView, views::Button)
+
+ public:
+  explicit SearchEngineChipView(OmniboxController* omnibox_controller);
+  SearchEngineChipView(const SearchEngineChipView&) = delete;
+  SearchEngineChipView& operator=(const SearchEngineChipView&) = delete;
+  ~SearchEngineChipView() override;
+
+  // Shows the icon and name of the current default search engine.
+  void Update();
+
+  // views::Button:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  void ShowMenu();
+  void SetFavicon(const gfx::Image& favicon);
+
+  raw_ptr<OmniboxController> omnibox_controller_;
+  raw_ptr<views::ImageView> favicon_view_ = nullptr;
+  // Keywords of the engines in the menu, indexed by command id.
+  std::vector<std::u16string> keywords_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  base::WeakPtrFactory<SearchEngineChipView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_SEARCH_ENGINE_CHIP_VIEW_H_
