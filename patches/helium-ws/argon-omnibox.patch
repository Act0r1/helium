@@ -0,0 +1,132 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/location_bar/search_engine_chip_view.h"
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/omnibox/omnibox_controller.h"
+#include "chrome/browser/ui/omnibox/omnibox_edit_model.h"
+#include "components/omnibox/browser/omnibox_client.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/vector_icons/vector_icons.h"
+#include "third_party/metrics_proto/omnibox_event.pb.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/image/image.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace {
+
+constexpr int kIconSize = 16;
+constexpr int kChevronSize = 14;
+
+}  // namespace
+
+SearchEngineChipView::SearchEngineChipView(OmniboxController* omnibox_controller)
+    : views::Button(base::BindRepeating(&SearchEngineChipView::ShowMenu,
+                                        base::Unretained(this))),
+      omnibox_controller_(omnibox_controller) {
+  // Clicking the chip must keep the omnibox focused and its popup open.
+  SetFocusBehavior(FocusBehavior::NEVER);
+
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 6), 2));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  favicon_view_ = AddChildView(std::make_unique<views::ImageView>());
+  favicon_view_->SetImageSize(gfx::Size(kIconSize, kIconSize));
+  AddChildView(std::make_unique<views::ImageView>(
+      ui::ImageModel::FromVectorIcon(vector_icons::kKeyboardArrowDownIcon,
+                                     kColorOmniboxResultsIcon, kChevronSize)));
+}
+
+SearchEngineChipView::~SearchEngineChipView() = default;
+
+void SearchEngineChipView::Update() {
+  OmniboxClient* client = omnibox_controller_->client();
+  if (const TemplateURL* engine =
+          client->GetTemplateURLService()->GetDefaultSearchProvider()) {
+    SetTooltipText(engine->short_name());
+    GetViewAccessibility().SetName(engine->short_name());
+  }
+
+  favicon_view_->SetImage(ui::ImageModel::FromVectorIcon(
+      vector_icons::kSearchIcon, kColorOmniboxResultsIcon, kIconSize));
+  const gfx::Image favicon = client->GetFaviconForDefaultSearchProvider(
+      base::BindOnce(&SearchEngineChipView::SetFavicon,
+                     weak_factory_.GetWeakPtr()));
+  if (!favicon.IsEmpty()) {
+    SetFavicon(favicon);
+  }
+}
+
+void SearchEngineChipView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::Button::OnBoundsChanged(previous_bounds);
+  SetBackground(views::CreateRoundedRectBackground(
+      kColorOmniboxResultsBackgroundSelected, height() / 2.0f));
+}
+
+void SearchEngineChipView::ExecuteCommand(int command_id, int event_flags) {
+  const TemplateURL* engine =
+      omnibox_controller_->client()
+          ->GetTemplateURLService()
+          ->GetTemplateURLForKeyword(keywords_[command_id]);
+  if (engine) {
+    omnibox_controller_->edit_model()->EnterKeywordMode(
+        metrics::OmniboxEventProto::CLICK_HINT_VIEW, engine, u"");
+  }
+}
+
+void SearchEngineChipView::ShowMenu() {
+  OmniboxClient* client = omnibox_controller_->client();
+  TemplateURLService* service = client->GetTemplateURLService();
+  const TemplateURL* default_engine = service->GetDefaultSearchProvider();
+
+  std::vector<const TemplateURL*> engines;
+  if (default_engine) {
+    engines.push_back(default_engine);
+  }
+  for (const TemplateURL* engine : service->GetTemplateURLs()) {
+    if (engine != default_engine && service->ShowInDefaultList(engine)) {
+      engines.push_back(engine);
+    }
+  }
+
+  keywords_.clear();
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (const TemplateURL* engine : engines) {
+    const gfx::Image favicon = client->GetFaviconForKeywordSearchProvider(
+        engine, base::DoNothing());
+    menu_model_->AddItemWithIcon(
+        static_cast<int>(keywords_.size()), engine->short_name(),
+        favicon.IsEmpty()
+            ? ui::ImageModel::FromVectorIcon(vector_icons::kSearchIcon,
+                                             ui::kColorMenuIcon, kIconSize)
+            : ui::ImageModel::FromImage(favicon));
+    keywords_.push_back(engine->keyword());
+  }
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::NO_FLAGS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kMouse);
+}
+
+void SearchEngineChipView::SetFavicon(const gfx::Image& favicon) {
+  favicon_view_->SetImage(ui::ImageModel::FromImage(favicon));
+}
+
+BEGIN_METADATA(SearchEngineChipView)
+END_METADATA
