+constexpr char kEssentialsId[] = "essentials";
+
+std::string NewId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+std::u16string FreeIcon(const std::vector<Workspace>& workspaces) {
+  for (std::u16string_view icon : kWorkspaceIcons) {
+    if (std::ranges::find(workspaces, icon, &Workspace::icon) ==
+        workspaces.end()) {
+      return std::u16string(icon);
+    }
+  }
+  return std::u16string(
+      kWorkspaceIcons[workspaces.size() % kWorkspaceIcons.size()]);
+}
+
+void FillMissingIcons(std::vector<Workspace>& workspaces) {
+  for (Workspace& workspace : workspaces) {
+    if (workspace.icon.empty()) {
+      workspace.icon = FreeIcon(workspaces);
+    }
+  }
+}
+
+std::u16string FreeName(const std::vector<Workspace>& workspaces) {
+  for (int number = 1;; ++number) {
+    std::u16string name = l10n_util::GetStringFUTF16(
+        IDS_WORKSPACE_NEW_NAME, base::NumberToString16(number));
+    if (std::ranges::find(workspaces, name, &Workspace::name) ==
+        workspaces.end()) {
+      return name;
+    }
+  }
+}
+
+// Colors of new workspaces, in the order of the former tab group colors after
+// grey, which old sessions stored as `kColorKey`.
+constexpr auto kPresetColors = std::to_array<SkColor>({
+    SkColorSetRGB(0x4C, 0x8D, 0xF6), SkColorSetRGB(0xE5, 0x53, 0x4B),
+    SkColorSetRGB(0xF2, 0xC9, 0x4C), SkColorSetRGB(0x3F, 0xB9, 0x50),
+    SkColorSetRGB(0xF7, 0x78, 0xBA), SkColorSetRGB(0xA3, 0x71, 0xF7),
+    SkColorSetRGB(0x39, 0xC5, 0xCF), SkColorSetRGB(0xF0, 0x88, 0x3E),
+});
+
+// The first workspace keeps the profile theme, the others cycle the presets.
+WorkspaceTheme ThemeForIndex(size_t index) {
+  WorkspaceTheme theme;
+  if (index > 0) {
+    theme.colors = {kPresetColors[(index - 1) % kPresetColors.size()]};
+  }
+  return theme;
+}
+
+std::string ColorToString(SkColor color) {
+  return base::StringPrintf("#%06X", color & 0xFFFFFF);
+}
+
+std::optional<SkColor> ColorFromString(std::string_view text) {
+  uint32_t rgb = 0;
+  if (text.size() != 7 || text[0] != '#' ||
+      !base::HexStringToUInt(text.substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetA(rgb, SK_AlphaOPAQUE);
+}
+
+base::DictValue SerializeTheme(const WorkspaceTheme& theme) {
+  base::ListValue colors;
+  for (SkColor color : theme.colors) {
+    colors.Append(ColorToString(color));
+  }
+  return base::DictValue()
+      .Set(kThemeColorsKey, std::move(colors))
+      .Set(kThemeIntensityKey, static_cast<double>(theme.intensity))
+      .Set(kThemeGrainKey, theme.grain)
+      .Set(kThemeModeKey, static_cast<int>(theme.mode));
+}
+
+// Reads the theme of a workspace, or converts the tab group color index that
+// sessions stored before themes existed.
+std::optional<WorkspaceTheme> DeserializeTheme(const base::DictValue& dict) {
+  WorkspaceTheme theme;
+  if (const base::DictValue* value = dict.FindDict(kThemeKey)) {
+    if (const base::ListValue* colors = value->FindList(kThemeColorsKey)) {
+      for (const base::Value& color : *colors) {
+        const std::optional<SkColor> parsed =
+            color.is_string() ? ColorFromString(color.GetString())
+                              : std::nullopt;
+        if (parsed && theme.colors.size() < kMaxThemeColors) {
+          theme.colors.push_back(*parsed);
+        }
+      }
+    }
+    theme.intensity = static_cast<float>(std::clamp(
+        value->FindDouble(kThemeIntensityKey).value_or(theme.intensity), 0.0,
+        1.0));
+    theme.grain = value->FindBool(kThemeGrainKey).value_or(theme.grain);
+    const int mode = value->FindInt(kThemeModeKey).value_or(0);
+    if (mode >= static_cast<int>(WorkspaceColorMode::kSystem) &&
+        mode <= static_cast<int>(WorkspaceColorMode::kDark)) {
+      theme.mode = static_cast<WorkspaceColorMode>(mode);
+    }
+    return theme;
+  }
+  const std::optional<int> color = dict.FindInt(kColorKey);
+  if (!color || *color < 0 || *color > static_cast<int>(kPresetColors.size())) {
+    return std::nullopt;
+  }
+  if (*color > 0) {
+    theme.colors = {kPresetColors[*color - 1]};
+  }
+  return theme;
+}
