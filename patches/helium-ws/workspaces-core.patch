+    u"🐶", u"🌸", u"🌙", u"🌞", u"🍀", u"🎁", u"🧳", u"🚗",
+});
+
+inline constexpr size_t kMaxThemeColors = 3;
+
+enum class WorkspaceColorMode {
+  kSystem = 0,
+  kLight = 1,
+  kDark = 2,
+};
+
+// Arc-style theme of a workspace: a gradient of up to `kMaxThemeColors` colors
+// painted behind the browser chrome, whose first color also seeds the browser
+// color palette. A theme without colors keeps the profile theme.
+struct WorkspaceTheme {
+  std::vector<SkColor> colors;
+  // From 0 to 1: how vivid the palette and how opaque the gradient are.
+  float intensity = 0.5f;
+  bool grain = true;
+  WorkspaceColorMode mode = WorkspaceColorMode::kSystem;
+
+  bool operator==(const WorkspaceTheme&) const = default;
+};
+
+struct Workspace {
+  std::string id;
+  std::u16string name;
+  std::u16string icon;
+  WorkspaceTheme theme;
+  bool pinned_collapsed = false;
+
+  bool operator==(const Workspace&) const = default;
+};
+
+// Splits the tabs of a window into workspaces. Pinned tabs belong to their
+// workspace, except Essentials, which are shared by all workspaces. Pinned and
+// unpinned tabs of a workspace are each kept as one contiguous block, in the
+// order of the workspace list, with Essentials first. Workspaces only hide tabs
+// while the vertical tab strip is shown.
+class WorkspaceController : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(WorkspaceController);
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnWorkspacesChanged() {}
+    virtual void OnActiveWorkspaceChanged() {}
+  };
+
+  explicit WorkspaceController(BrowserWindowInterface* browser);
+  ~WorkspaceController() override;
+  WorkspaceController(const WorkspaceController&) = delete;
+  WorkspaceController& operator=(const WorkspaceController&) = delete;
+
+  static WorkspaceController* From(BrowserWindowInterface* browser);
+
+  BrowserWindowInterface* browser() const { return browser_; }
+
+  // Serializes `workspaces` with `active` id into the window extra data format.
+  static std::string Serialize(const std::vector<Workspace>& workspaces,
+                               const std::string& active);
+  // Parses the window extra data format. Returns false on invalid input.
+  static bool Deserialize(const std::string& json,
+                          std::vector<Workspace>* workspaces,
+                          std::string* active);
+
+  const std::vector<Workspace>& GetWorkspaces() const { return workspaces_; }
+  const Workspace* GetActiveWorkspace() const;
+  // Returns the theme of the active workspace while workspaces are shown and
+  // the theme has colors or forces a color mode, nullptr otherwise.
+  const WorkspaceTheme* GetShownTheme() const;
+  // Returns nullptr for Essentials.
+  const Workspace* GetWorkspaceOf(const tabs::TabInterface* tab) const;
+  bool IsEssential(const tabs::TabInterface* tab) const;
+  // Returns true for pinned tabs of a workspace, which the vertical tab strip
+  // shows as rows below the Essentials tiles.
+  bool IsWorkspacePinned(const tabs::TabInterface* tab) const;
+
+  void ActivateWorkspace(const std::string& id);
+  void ActivateWorkspaceAt(int index);
+  void ActivateNextWorkspace();
+  void ActivatePreviousWorkspace();
+  std::string CreateWorkspace();
+  void UpdateWorkspace(const Workspace& workspace);
+  // Adds workspaces from serialized window data that this window lacks. Used
+  // when a session is restored into an already open window.
+  void MergeRestoredWorkspaces(const std::string& json);
+  // Closes all tabs of the workspace and removes it. The last workspace can't
+  // be closed.
+  void CloseWorkspace(const std::string& id);
+  void MoveTabsToWorkspace(const std::vector<tabs::TabInterface*>& tabs,
+                           const std::string& id);
+  // Marks `tabs` as Essentials, or returns them to the active workspace. The
+  // caller pins or unpins them.
+  void SetEssential(const std::vector<tabs::TabInterface*>& tabs,
+                    bool essential);
+
+  // Returns the site pattern of a rule that opens `tab`'s site in its
+  // workspace, or an empty string if `tab` can't have such a rule.
+  std::string GetRulePatternFor(const tabs::TabInterface* tab) const;
+  // Returns true if new tabs of `tab`'s site already open in its workspace.
+  bool HasRuleFor(const tabs::TabInterface* tab) const;
+  // Adds or removes the rule that opens `tab`'s site in its workspace.
+  void ToggleRuleFor(const tabs::TabInterface* tab);
+
+  // Returns true if workspaces currently hide tabs of inactive workspaces.
+  bool IsFilteringTabs() const;
+  bool IsTabVisible(const tabs::TabInterface* tab) const;
+  std::vector<tabs::TabInterface*> GetVisibleTabs() const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  class FirstNavigationObserver;
+
+  const Workspace* FindWorkspace(const std::string& id) const;
+  // Returns the workspace whose rule matches `url` for a new tab, or an empty
+  // string if no rule applies.
+  std::string GetRuleWorkspace(const tabs::TabInterface* tab,
+                               const GURL& url) const;
+  // Picks the workspace of a tab that was just inserted. Tabs opened by pages
+  // get their URL later, so they are matched on their first navigation.
+  std::string GetInsertedTabWorkspace(tabs::TabInterface* tab);
+  void OnFirstNavigation(tabs::TabHandle handle, const GURL& url);
+  bool ShouldFollowRule() const;
+  std::string GetWorkspaceIdOf(const tabs::TabInterface* tab) const;
+  void SetActive(const std::string& id);
+  void ActivateRelativeWorkspace(int offset);
+  bool IsClosingWindow() const;
+  bool IsRestoring() const;
+  void ScheduleUpdate();
+  void Update();
+  void AssignUnits();
+  void ArrangeTabs();
+  void Persist();
+  void NotifyWorkspacesChanged();
+  void OnSessionRestored(Profile* profile, int tab_count);
+
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void TabGroupedStateChanged(TabStripModel* model,
+                              std::optional<tab_groups::TabGroupId> old_group,
+                              std::optional<tab_groups::TabGroupId> new_group,
+                              tabs::TabInterface* tab,
+                              int index) override;
+  void OnSplitTabChanged(const SplitTabChange& change) override;
+  void OnTabStripModelDestroyed(TabStripModel* model) override;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<TabStripModel> model_;
+  base::ObserverList<Observer> observers_;
+  std::vector<Workspace> workspaces_;
+  std::string active_;
+  std::map<tabs::TabHandle, std::string> tab_workspaces_;
+  std::map<tabs::TabHandle, std::string> persisted_tab_workspaces_;
+  std::string persisted_window_;
+  std::vector<tabs::TabHandle> activation_order_;
+  std::map<tabs::TabHandle, std::unique_ptr<FirstNavigationObserver>>
+      first_navigation_observers_;
+  bool update_pending_ = false;
+  bool updating_ = false;
+  base::CallbackListSubscription mode_subscription_;
+  base::CallbackListSubscription restore_subscription_;
+  ui::ScopedUnownedUserData<WorkspaceController> scoped_unowned_user_data_;
+  base::WeakPtrFactory<WorkspaceController> weak_factory_{this};
+};
+
+// Returns true if `tab` is pinned and shown as a tile: an Essential, or any
+// pinned tab while workspaces don't filter tabs.
+bool IsPinnedTile(tabs::TabInterface* tab);
+
+}  // namespace workspaces
+
