+bool BrowserTabStripModelDelegate::IsTabHiddenByWorkspace(
+    const tabs::TabInterface* tab) const {
+  const auto* controller = workspaces::WorkspaceController::From(browser_);
+  return controller && !controller->IsTabVisible(tab);
+}
+
+bool BrowserTabStripModelDelegate::SupportsEssentials() const {
+  return workspaces::WorkspaceController::From(browser_) != nullptr;
+}
+
+bool BrowserTabStripModelDelegate::IsTabEssential(
+    const tabs::TabInterface* tab) const {
+  const auto* controller = workspaces::WorkspaceController::From(browser_);
+  return controller && controller->IsEssential(tab);
+}
+
+void BrowserTabStripModelDelegate::SetTabsEssential(
+    const std::vector<tabs::TabInterface*>& tabs,
+    bool essential) {
+  if (auto* controller = workspaces::WorkspaceController::From(browser_)) {
+    controller->SetEssential(tabs, essential);
+  }
+}
+
+std::u16string BrowserTabStripModelDelegate::GetWorkspaceRuleSite(
+    const tabs::TabInterface* tab) const {
+  const auto* controller = workspaces::WorkspaceController::From(browser_);
+  return controller ? base::UTF8ToUTF16(controller->GetRulePatternFor(tab))
+                    : std::u16string();
+}
+
+bool BrowserTabStripModelDelegate::HasWorkspaceRule(
+    const tabs::TabInterface* tab) const {
+  const auto* controller = workspaces::WorkspaceController::From(browser_);
+  return controller && controller->HasRuleFor(tab);
+}
+
+void BrowserTabStripModelDelegate::ToggleWorkspaceRule(
+    const tabs::TabInterface* tab) {
+  if (auto* controller = workspaces::WorkspaceController::From(browser_)) {
+    controller->ToggleRuleFor(tab);
+  }
+}
