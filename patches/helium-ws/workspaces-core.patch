+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/workspaces/workspace_controller.h"
+
+#include <string>
+#include <vector>
+
+#include "base/run_loop.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "url/gurl.h"
+
+namespace workspaces {
+
+class WorkspaceControllerTest : public BrowserWithTestWindowTest {
+ protected:
+  WorkspaceController* controller() {
+    return WorkspaceController::From(browser());
+  }
+  TabStripModel* model() { return browser()->GetTabStripModel(); }
+  void Flush() { base::RunLoop().RunUntilIdle(); }
+  void EnableVerticalTabs() {
+    tabs::VerticalTabStripStateController::From(browser())
+        ->SetVerticalTabsEnabled(true);
+    Flush();
+  }
+  tabs::TabInterface* AddTabToEnd() {
+    AddTab(browser(), GURL("https://example.test/"));
+    tabs::TabInterface* tab = model()->GetActiveTab();
+    model()->MoveWebContentsAt(model()->GetIndexOfTab(tab),
+                               model()->count() - 1, false);
+    Flush();
+    return tab;
+  }
+  const std::string& WorkspaceOf(tabs::TabInterface* tab) {
+    return controller()->GetWorkspaceOf(tab)->id;
+  }
+  const std::string& ActiveId() {
+    return controller()->GetActiveWorkspace()->id;
+  }
+};
+
+TEST_F(WorkspaceControllerTest, NewTabsJoinActiveWorkspace) {
+  ASSERT_NE(nullptr, controller());
+  ASSERT_EQ(1u, controller()->GetWorkspaces().size());
+  tabs::TabInterface* first = AddTabToEnd();
+  EXPECT_EQ(ActiveId(), WorkspaceOf(first));
+
+  const std::string second = controller()->CreateWorkspace();
+  Flush();
+  EXPECT_EQ(second, ActiveId());
+  EXPECT_EQ(second, WorkspaceOf(model()->GetActiveTab()));
+  EXPECT_EQ(second, WorkspaceOf(AddTabToEnd()));
+}
+
+TEST_F(WorkspaceControllerTest, WorkspaceTabsStayContiguous) {
+  const std::string first = ActiveId();
+  tabs::TabInterface* a1 = AddTabToEnd();
+  const std::string second = controller()->CreateWorkspace();
+  Flush();
+  tabs::TabInterface* b1 = model()->GetActiveTab();
+  controller()->ActivateWorkspace(first);
+  Flush();
+  tabs::TabInterface* a2 = AddTabToEnd();
+
+  EXPECT_EQ(first, WorkspaceOf(a2));
+  EXPECT_EQ(0, model()->GetIndexOfTab(a1));
+  EXPECT_EQ(1, model()->GetIndexOfTab(a2));
+  EXPECT_EQ(2, model()->GetIndexOfTab(b1));
+}
+
+TEST_F(WorkspaceControllerTest, SwitchingHidesOtherWorkspaces) {
+  EnableVerticalTabs();
+  const std::string first = ActiveId();
+  tabs::TabInterface* a1 = AddTabToEnd();
+  tabs::TabInterface* pinned = AddTabToEnd();
+  model()->SetTabPinned(model()->GetIndexOfTab(pinned), true);
+  Flush();
+  model()->ActivateTab(a1);
+  Flush();
+
+  controller()->CreateWorkspace();
+  Flush();
+  tabs::TabInterface* b1 = model()->GetActiveTab();
+  EXPECT_FALSE(controller()->IsTabVisible(a1));
+  EXPECT_FALSE(controller()->IsTabVisible(pinned));
+  EXPECT_TRUE(controller()->IsTabVisible(b1));
+
+  controller()->ActivateWorkspace(first);
+  Flush();
+  EXPECT_EQ(a1, model()->GetActiveTab());
+  EXPECT_TRUE(controller()->IsTabVisible(pinned));
+  EXPECT_FALSE(controller()->IsTabVisible(b1));
+}
+
+TEST_F(WorkspaceControllerTest, PinnedTabsStayInTheirWorkspace) {
+  const std::string first = ActiveId();
+  tabs::TabInterface* a1 = AddTabToEnd();
+  model()->SetTabPinned(model()->GetIndexOfTab(a1), true);
+  Flush();
+  EXPECT_EQ(first, WorkspaceOf(a1));
+  EXPECT_FALSE(controller()->IsEssential(a1));
+
+  const std::string second = controller()->CreateWorkspace();
+  Flush();
+  model()->SetTabPinned(model()->GetIndexOfTab(a1), false);
+  Flush();
+  EXPECT_EQ(first, WorkspaceOf(a1));
+  EXPECT_EQ(second, ActiveId());
+}
+
+TEST_F(WorkspaceControllerTest, EssentialsAreSharedAndComeFirst) {
+  EnableVerticalTabs();
+  const std::string first = ActiveId();
+  tabs::TabInterface* pinned = AddTabToEnd();
+  model()->SetTabPinned(model()->GetIndexOfTab(pinned), true);
+  tabs::TabInterface* essential = AddTabToEnd();
+  controller()->SetEssential({essential}, true);
+  model()->SetTabPinned(model()->GetIndexOfTab(essential), true);
+  Flush();
+  EXPECT_TRUE(controller()->IsEssential(essential));
+  EXPECT_EQ(nullptr, controller()->GetWorkspaceOf(essential));
+  EXPECT_EQ(0, model()->GetIndexOfTab(essential));
+  EXPECT_EQ(1, model()->GetIndexOfTab(pinned));
+
+  const std::string second = controller()->CreateWorkspace();
+  Flush();
+  EXPECT_TRUE(controller()->IsTabVisible(essential));
+  model()->ActivateTab(essential);
+  Flush();
+  EXPECT_EQ(second, ActiveId());
+
+  controller()->SetEssential({essential}, false);
+  model()->SetTabPinned(model()->GetIndexOfTab(essential), false);
+  Flush();
+  EXPECT_FALSE(controller()->IsEssential(essential));
+  EXPECT_EQ(second, WorkspaceOf(essential));
+  EXPECT_EQ(first, WorkspaceOf(pinned));
+}
+
+TEST_F(WorkspaceControllerTest, CloseWorkspaceClosesItsPinnedTabs) {
+  tabs::TabInterface* essential = AddTabToEnd();
+  controller()->SetEssential({essential}, true);
+  model()->SetTabPinned(model()->GetIndexOfTab(essential), true);
+  const std::string second = controller()->CreateWorkspace();
+  Flush();
+  tabs::TabInterface* b1 = AddTabToEnd();
+  model()->SetTabPinned(model()->GetIndexOfTab(b1), true);
+  Flush();
+  ASSERT_EQ(3, model()->count());
+
+  controller()->CloseWorkspace(second);
+  Flush();
+  ASSERT_EQ(2, model()->count());
+  EXPECT_EQ(essential, model()->GetTabAtIndex(0));
+  EXPECT_EQ(ActiveId(), WorkspaceOf(model()->GetTabAtIndex(1)));
+}
+
+TEST_F(WorkspaceControllerTest, HorizontalTabsShowEverything) {
+  tabs::TabInterface* a1 = AddTabToEnd();
+  controller()->CreateWorkspace();
+  Flush();
+  EXPECT_FALSE(controller()->IsFilteringTabs());
+  EXPECT_TRUE(controller()->IsTabVisible(a1));
+}
+
+TEST_F(WorkspaceControllerTest, CloseSelectsTabInSameWorkspace) {
+  EnableVerticalTabs();
+  const std::string first = ActiveId();
+  tabs::TabInterface* a1 = AddTabToEnd();
+  tabs::TabInterface* a2 = AddTabToEnd();
+  controller()->CreateWorkspace();
+  Flush();
+  controller()->ActivateWorkspace(first);
+  Flush();
+  model()->ActivateTab(a2);
+  Flush();
+
+  model()->CloseWebContentsAt(model()->GetIndexOfTab(a2),
+                              TabCloseTypes::CLOSE_USER_GESTURE);
+  Flush();
+  EXPECT_EQ(a1, model()->GetActiveTab());
+  EXPECT_EQ(first, ActiveId());
+}
+
+TEST_F(WorkspaceControllerTest, MoveTabsToWorkspace) {
+  const std::string first = ActiveId();
+  tabs::TabInterface* a1 = AddTabToEnd();
+  tabs::TabInterface* a2 = AddTabToEnd();
+  const std::string second = controller()->CreateWorkspace();
+  Flush();
+  controller()->ActivateWorkspace(first);
+  Flush();
+
+  controller()->MoveTabsToWorkspace({a1}, second);
+  Flush();
+  EXPECT_EQ(second, WorkspaceOf(a1));
+  EXPECT_EQ(first, WorkspaceOf(a2));
+  EXPECT_EQ(0, model()->GetIndexOfTab(a2));
+}
+
+TEST_F(WorkspaceControllerTest, CloseWorkspaceClosesItsTabs) {
+  const std::string first = ActiveId();
+  tabs::TabInterface* a1 = AddTabToEnd();
+  const std::string second = controller()->CreateWorkspace();
+  Flush();
+  AddTabToEnd();
+  ASSERT_EQ(3, model()->count());
+
+  controller()->CloseWorkspace(second);
+  Flush();
+  EXPECT_EQ(1u, controller()->GetWorkspaces().size());
+  EXPECT_EQ(first, ActiveId());
+  EXPECT_EQ(1, model()->count());
+  EXPECT_EQ(a1, model()->GetActiveTab());
+
+  controller()->CloseWorkspace(first);
+  Flush();
+  EXPECT_EQ(1u, controller()->GetWorkspaces().size());
+}
+
+TEST_F(WorkspaceControllerTest, SerializeRoundTrip) {
+  const std::vector<Workspace> workspaces = {
+      {"a", u"Work", u"💼",
+       {{SkColorSetRGB(0x12, 0x34, 0x56), SK_ColorWHITE}, 0.75f, false,
+        WorkspaceColorMode::kDark}},
+      {"b", u"Home", u"", {}, /*pinned_collapsed=*/true},
+  };
+  std::vector<Workspace> parsed;
+  std::string active;
+  ASSERT_TRUE(WorkspaceController::Deserialize(
+      WorkspaceController::Serialize(workspaces, "b"), &parsed, &active));
+  EXPECT_EQ(workspaces, parsed);
+  EXPECT_EQ("b", active);
+  EXPECT_FALSE(WorkspaceController::Deserialize("{", &parsed, &active));
+}
+
+TEST_F(WorkspaceControllerTest, DeserializeConvertsTabGroupColors) {
+  std::vector<Workspace> parsed;
+  std::string active;
+  ASSERT_TRUE(WorkspaceController::Deserialize(
+      R"({"active":"a","workspaces":[)"
+      R"({"id":"a","name":"Work","icon":"","color":0},)"
+      R"({"id":"b","name":"Home","icon":"","color":1}]})",
+      &parsed, &active));
+  ASSERT_EQ(2u, parsed.size());
+  EXPECT_TRUE(parsed[0].theme.colors.empty());
+  EXPECT_EQ(std::vector<SkColor>{SkColorSetRGB(0x4C, 0x8D, 0xF6)},
+            parsed[1].theme.colors);
+}
+
+TEST_F(WorkspaceControllerTest, ThemeIsShownWithColorsAndVerticalTabs) {
+  controller()->CreateWorkspace();
+  Flush();
+  EXPECT_EQ(nullptr, controller()->GetShownTheme());
+  EnableVerticalTabs();
+  ASSERT_NE(nullptr, controller()->GetShownTheme());
+  controller()->ActivateWorkspaceAt(0);
+  Flush();
+  EXPECT_EQ(nullptr, controller()->GetShownTheme());
+  controller()->ActivateWorkspaceAt(1);
+  Flush();
+  ASSERT_NE(nullptr, controller()->GetShownTheme());
+  EXPECT_EQ(controller()->GetActiveWorkspace()->theme,
+            *controller()->GetShownTheme());
+}
+
+TEST_F(WorkspaceControllerTest, ThemeIsShownWithColorModeOnly) {
+  EnableVerticalTabs();
+  Workspace workspace = *controller()->GetActiveWorkspace();
+  workspace.theme = WorkspaceTheme();
+  controller()->UpdateWorkspace(workspace);
+  EXPECT_EQ(nullptr, controller()->GetShownTheme());
+  workspace.theme.mode = WorkspaceColorMode::kDark;
+  controller()->UpdateWorkspace(workspace);
+  ASSERT_NE(nullptr, controller()->GetShownTheme());
+  EXPECT_TRUE(controller()->GetShownTheme()->colors.empty());
+}
+
+TEST_F(WorkspaceControllerTest, MergeRestoredWorkspacesAddsMissing) {
+  const std::string active = ActiveId();
+  const Workspace existing = *controller()->GetActiveWorkspace();
+  const Workspace restored = {"restored", u"Work", u"🚗", {{SK_ColorRED}}};
+  controller()->MergeRestoredWorkspaces(
+      WorkspaceController::Serialize({existing, restored}, "restored"));
+  ASSERT_EQ(2u, controller()->GetWorkspaces().size());
+  EXPECT_EQ(restored, controller()->GetWorkspaces()[1]);
+  EXPECT_EQ(active, ActiveId());
+}
+
+TEST_F(WorkspaceControllerTest, NewWorkspacesGetFreeNameAndIcon) {
+  EXPECT_EQ(kWorkspaceIcons[0], controller()->GetActiveWorkspace()->icon);
+  const std::string first = controller()->CreateWorkspace();
+  const std::string second = controller()->CreateWorkspace();
+  controller()->CloseWorkspace(first);
+  Flush();
+  controller()->CreateWorkspace();
+  Flush();
+
+  const std::vector<Workspace>& workspaces = controller()->GetWorkspaces();
+  ASSERT_EQ(3u, workspaces.size());
+  EXPECT_EQ(second, workspaces[1].id);
+  EXPECT_EQ(u"Workspace 2", workspaces[1].name);
+  EXPECT_EQ(kWorkspaceIcons[2], workspaces[1].icon);
+  EXPECT_EQ(u"Workspace 1", workspaces[2].name);
+  EXPECT_EQ(kWorkspaceIcons[1], workspaces[2].icon);
+}
+
+TEST_F(WorkspaceControllerTest, RestoredWorkspacesWithoutIconGetOne) {
+  controller()->MergeRestoredWorkspaces(WorkspaceController::Serialize(
+      {{"restored", u"Work", u"", {{SK_ColorRED}}}},
+      "restored"));
+  ASSERT_EQ(2u, controller()->GetWorkspaces().size());
+  EXPECT_EQ(kWorkspaceIcons[1], controller()->GetWorkspaces()[1].icon);
+}
+
+TEST_F(WorkspaceControllerTest, InertForPopupAndIncognito) {
+  auto popup =
+      CreateBrowser(profile(), BrowserWindowInterface::TYPE_POPUP, false);
+  EXPECT_EQ(nullptr, WorkspaceController::From(popup.get()));
+  auto incognito = CreateBrowser(profile()->GetPrimaryOTRProfile(true),
+                                 BrowserWindowInterface::TYPE_NORMAL, false);
+  EXPECT_EQ(nullptr, WorkspaceController::From(incognito.get()));
+}
+
