+class Profile;
+
+namespace workspaces {
+
+// Emoji offered by the workspace icon picker. New workspaces get the first one
+// not used by another workspace.
+inline constexpr auto kWorkspaceIcons = std::to_array<std::u16string_view>({
+    u"🏠", u"💼", u"💻", u"📚", u"🎓", u"🎮", u"🎵", u"🎬",
+    u"🎨", u"📷", u"📝", u"🔬", u"💡", u"🚀", u"🛒", u"💰",
