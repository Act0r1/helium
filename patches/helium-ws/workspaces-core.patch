new file mode 100644
index 000000000..a4dbea27a
--- /dev/null
+++ b/chrome/browser/ui/workspaces/workspace_rules.cc
@@ -0,0 +1,177 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/workspaces/workspace_rules.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/pattern.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "url/gurl.h"
+
+namespace workspaces {
+
+namespace {
+
+constexpr char kPatternKey[] = "pattern";
+constexpr char kWorkspaceKey[] = "workspace";
+constexpr int kExactHostScore = 1000;
+
+std::pair<std::string_view, std::string_view> SplitPattern(
+    std::string_view pattern) {
+  const size_t slash = pattern.find('/');
+  if (slash == std::string_view::npos) {
+    return {pattern, {}};
+  }
+  return {pattern.substr(0, slash), pattern.substr(slash)};
+}
+
+bool IsHostChar(char c) {
+  return base::IsAsciiAlphaNumeric(c) || c == '.' || c == '-' || c == '*';
+}
+
+// Returns how specific `pattern` is if it matches `host` and `path`, -1
+// otherwise.
+int MatchScore(std::string_view pattern,
+               std::string_view host,
+               std::string_view path) {
+  const auto [pattern_host, pattern_path] = SplitPattern(pattern);
+  const bool host_mask = pattern_host.find('*') != std::string_view::npos;
+  if (host_mask ? !base::MatchPattern(host, pattern_host)
+                : host != pattern_host &&
+                      !host.ends_with(base::StrCat({".", pattern_host}))) {
+    return -1;
+  }
+  if (!pattern_path.empty()) {
+    const bool matches =
+        pattern_path.find('*') != std::string_view::npos
+            ? base::MatchPattern(path, pattern_path)
+            : path == pattern_path ||
+                  (path.starts_with(pattern_path) &&
+                   (pattern_path.ends_with('/') ||
+                    path[pattern_path.size()] == '/'));
+    if (!matches) {
+      return -1;
+    }
+  }
+  return (host_mask ? 0 : kExactHostScore) +
+         static_cast<int>(std::ranges::count_if(
+             pattern, [](char c) { return c != '*'; }));
+}
+
+}  // namespace
+
+std::optional<std::string> NormalizeRulePattern(std::string_view pattern) {
+  std::string text =
+      base::ToLowerASCII(base::TrimWhitespaceASCII(pattern, base::TRIM_ALL));
+  if (const size_t scheme = text.find("://"); scheme != std::string::npos) {
+    text.erase(0, scheme + 3);
+  }
+  if (text.ends_with('/') && text.find('/') == text.size() - 1) {
+    text.pop_back();
+  }
+  const auto [host, path] = SplitPattern(text);
+  const bool host_has_name = std::ranges::any_of(
+      host, [](char c) { return c != '.' && c != '*'; });
+  const bool path_is_valid = std::ranges::none_of(path, [](char c) {
+    return base::IsAsciiWhitespace(c) || c == '?' || c == '#' || c == '\\';
+  });
+  if (!host_has_name || !std::ranges::all_of(host, IsHostChar) ||
+      !path_is_valid) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+std::string RulePatternForUrl(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return std::string();
+  }
+  std::string_view host = url.host();
+  if (host.starts_with("www.")) {
+    host.remove_prefix(4);
+  }
+  return NormalizeRulePattern(host).value_or(std::string());
+}
+
+std::optional<WorkspaceRule> MatchRule(const std::vector<WorkspaceRule>& rules,
+                                       const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  const std::string path = base::ToLowerASCII(url.path());
+  const WorkspaceRule* best = nullptr;
+  int best_score = -1;
+  for (const WorkspaceRule& rule : rules) {
+    const int score = MatchScore(rule.pattern, url.host(), path);
+    if (score > best_score) {
+      best = &rule;
+      best_score = score;
+    }
+  }
+  return best ? std::optional<WorkspaceRule>(*best) : std::nullopt;
+}
+
+std::vector<WorkspaceRule> GetRules(const PrefService& prefs) {
+  std::vector<WorkspaceRule> rules;
+  for (const base::Value& value :
+       prefs.GetList(prefs::kHeliumWorkspaceRules)) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* pattern = dict ? dict->FindString(kPatternKey) : nullptr;
+    const std::string* workspace =
+        dict ? dict->FindString(kWorkspaceKey) : nullptr;
+    if (pattern && workspace) {
+      rules.push_back({*pattern, *workspace});
+    }
+  }
+  return rules;
+}
+
+bool SetRule(PrefService& prefs,
+             std::string_view pattern,
+             const std::string& workspace_id) {
+  const std::optional<std::string> normalized = NormalizeRulePattern(pattern);
+  if (!normalized || workspace_id.empty()) {
+    return false;
+  }
+  ScopedListPrefUpdate update(&prefs, prefs::kHeliumWorkspaceRules);
+  update->EraseIf([&normalized](const base::Value& value) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* existing =
+        dict ? dict->FindString(kPatternKey) : nullptr;
+    return existing && *existing == *normalized;
+  });
+  update->Append(base::DictValue()
+                     .Set(kPatternKey, *normalized)
+                     .Set(kWorkspaceKey, workspace_id));
+  return true;
+}
+
+void RemoveRule(PrefService& prefs, std::string_view pattern) {
+  ScopedListPrefUpdate update(&prefs, prefs::kHeliumWorkspaceRules);
+  update->EraseIf([pattern](const base::Value& value) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* existing =
+        dict ? dict->FindString(kPatternKey) : nullptr;
+    return existing && *existing == pattern;
+  });
+}
+
+void RemoveRulesOf(PrefService& prefs, const std::string& workspace_id) {
+  ScopedListPrefUpdate update(&prefs, prefs::kHeliumWorkspaceRules);
+  update->EraseIf([&workspace_id](const base::Value& value) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* existing =
+        dict ? dict->FindString(kWorkspaceKey) : nullptr;
+    return existing && *existing == workspace_id;
+  });
+}
+
+}  // namespace workspaces
