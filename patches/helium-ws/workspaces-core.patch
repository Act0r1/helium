+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WORKSPACES_WORKSPACE_RULES_H_
+#define CHROME_BROWSER_UI_WORKSPACES_WORKSPACE_RULES_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+class GURL;
+class PrefService;
+
+namespace workspaces {
+
+// Opens new tabs of sites matching `pattern` in the workspace `workspace_id`.
+// A pattern is a host with an optional path. A host without `*` also matches
+// its subdomains, `*` matches any text.
+struct WorkspaceRule {
+  std::string pattern;
+  std::string workspace_id;
+
+  bool operator==(const WorkspaceRule&) const = default;
+};
+
+// Returns `pattern` trimmed, lowercased and without a scheme, or nullopt if it
+// is not a valid pattern.
+std::optional<std::string> NormalizeRulePattern(std::string_view pattern);
+
+// Returns the pattern a new rule for `url` uses: its host without "www.".
+// Empty for URLs that are not http or https.
+std::string RulePatternForUrl(const GURL& url);
+
+// Returns the most specific rule that matches `url`: a host without `*` beats
+// a mask, then the longer pattern wins.
+std::optional<WorkspaceRule> MatchRule(const std::vector<WorkspaceRule>& rules,
+                                       const GURL& url);
+
+std::vector<WorkspaceRule> GetRules(const PrefService& prefs);
+// Adds a rule, or moves the rule with the same pattern to `workspace_id`.
+// Returns false if `pattern` is invalid.
+bool SetRule(PrefService& prefs,
+             std::string_view pattern,
+             const std::string& workspace_id);
+void RemoveRule(PrefService& prefs, std::string_view pattern);
+void RemoveRulesOf(PrefService& prefs, const std::string& workspace_id);
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_WORKSPACES_WORKSPACE_RULES_H_
