+bool PinnedTabContainerView::IsShowingWorkspaceRows() const {
+  return collection_node_ && workspace_observation_.IsObserving() &&
+         workspace_observation_.GetSource()->IsFilteringTabs();
+}
+
+int PinnedTabContainerView::GetAnimatedHeight(
+    const views::SizeBounds& size_bounds,
+    int height) const {
+  if (!rows_animation_.is_animating() || !IsShowingWorkspaceRows()) {
+    return height;
+  }
+  return gfx::Tween::IntValueBetween(
+      rows_animation_.GetCurrentValue(),
+      CalculateVerticalLayout(size_bounds, /*rows_collapsed=*/true)
+          .host_size.height(),
+      CalculateVerticalLayout(size_bounds, /*rows_collapsed=*/false)
+          .host_size.height());
