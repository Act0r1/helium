+
+// Lets the theme of the active workspace replace the profile theme. Returns
+// whether workspace colors are applied.
+bool ApplyWorkspaceTheme(BrowserWindowInterface* browser,
+                         ui::ColorProviderKey& key) {
+  const auto* controller = workspaces::WorkspaceController::From(browser);
+  const workspaces::WorkspaceTheme* theme =
+      controller ? controller->GetShownTheme() : nullptr;
+  if (!theme) {
+    return false;
+  }
+  switch (theme->mode) {
+    case workspaces::WorkspaceColorMode::kSystem:
+      break;
+    case workspaces::WorkspaceColorMode::kLight:
+      key.color_mode = ui::ColorProviderKey::ColorMode::kLight;
+      key.system_theme = ui::SystemTheme::kDefault;
+      break;
+    case workspaces::WorkspaceColorMode::kDark:
+      key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+      key.system_theme = ui::SystemTheme::kDefault;
+      break;
+  }
+  if (theme->colors.empty()) {
+    return false;
+  }
+  key.user_color = theme->colors.front();
+  key.user_color_source = ui::ColorProviderKey::UserColorSource::kAccent;
+  key.scheme_variant =
+      theme->intensity < 1.0f / 3
+          ? ui::ColorProviderKey::SchemeVariant::kNeutral
+          : (theme->intensity < 2.0f / 3
+                 ? ui::ColorProviderKey::SchemeVariant::kTonalSpot
+                 : ui::ColorProviderKey::SchemeVariant::kVibrant);
+  key.custom_theme = nullptr;
+  key.system_theme = ui::SystemTheme::kDefault;
+  return true;
+}
