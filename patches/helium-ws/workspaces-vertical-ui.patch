+void TabStripView::UpdateWorkspaceVisibility() {
+  if (!collection_node_ || !workspace_observation_.IsObserving()) {
+    return;
+  }
+  const auto* controller = workspace_observation_.GetSource();
+  for (const auto type :
+       {TabCollectionNode::Type::PINNED, TabCollectionNode::Type::UNPINNED}) {
+    auto* container = collection_node_->GetChildNodeOfType(type);
+    if (!container) {
+      continue;
+    }
+    for (const auto& child : container->children()) {
+      const TabCollectionNode* node = child.get();
+      while (node->type() != TabCollectionNode::Type::TAB &&
+             !node->children().empty()) {
+        node = node->children().front().get();
+      }
+      const tabs::TabInterface* tab =
+          node->type() == TabCollectionNode::Type::TAB
+              ? std::get<tabs::ConstDanglingUntriagedTabInterface>(
+                    node->GetNodeData())
+              : nullptr;
+      child->view()->SetVisible(!tab || controller->IsTabVisible(tab));
+    }
+    container->view()->InvalidateLayout();
+  }
+  InvalidateLayout();
+}
