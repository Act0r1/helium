+constexpr int kWheelSize = 176;
+constexpr float kHandleRadius = 9.0f;
+constexpr float kGrabDistance = 18.0f;
+constexpr float kWheelValue = 0.95f;
+constexpr int kButtonIconSize = 16;
+constexpr base::TimeDelta kThrottle = base::Milliseconds(40);
+constexpr SkColor kDefaultColor = SkColorSetRGB(0x4C, 0x8D, 0xF6);
+
+constexpr auto kModes = std::to_array<std::pair<WorkspaceColorMode, int>>({
+    {WorkspaceColorMode::kSystem, IDS_WORKSPACE_THEME_MODE_SYSTEM},
+    {WorkspaceColorMode::kLight, IDS_WORKSPACE_THEME_MODE_LIGHT},
+    {WorkspaceColorMode::kDark, IDS_WORKSPACE_THEME_MODE_DARK},
+});
+
+// Returns `color` with its hue rotated by `degrees`.
+SkColor RotateHue(SkColor color, float degrees) {
+  SkScalar hsv[3];
+  SkColorToHSV(color, hsv);
+  hsv[0] = std::fmod(hsv[0] + degrees, 360.0f);
+  return SkHSVToColor(hsv);
+}
