+void PinnedTabContainerView::ToggleRowsCollapsed() {
+  if (!workspace_observation_.IsObserving()) {
+    return;
+  }
+  workspaces::WorkspaceController* controller =
+      workspace_observation_.GetSource();
+  const workspaces::Workspace* active = controller->GetActiveWorkspace();
+  if (!active) {
+    return;
+  }
+  workspaces::Workspace workspace = *active;
+  workspace.pinned_collapsed = !workspace.pinned_collapsed;
+  controller->UpdateWorkspace(workspace);
+}
+
+void PinnedTabContainerView::UpdateRowsCollapsed(bool animate) {
+  if (!workspace_observation_.IsObserving()) {
+    return;
+  }
+  const workspaces::Workspace* active =
+      workspace_observation_.GetSource()->GetActiveWorkspace();
+  const bool collapsed = active && active->pinned_collapsed;
+  if (collapsed != rows_collapsed_) {
+    rows_collapsed_ = collapsed;
+    if (!animate) {
+      rows_animation_.Reset(collapsed ? 0 : 1);
+    } else if (collapsed) {
+      rows_animation_.Hide();
+    } else {
+      rows_animation_.Show();
+    }
+  }
+  top_band_->SetState(rows_collapsed_, rows_animation_.GetCurrentValue(),
+                      GetHiddenRowCount());
+  InvalidateLayout();
+}
+
+int PinnedTabContainerView::GetHiddenRowCount() const {
+  if (!IsShowingWorkspaceRows()) {
+    return 0;
+  }
+  const auto* controller = workspace_observation_.GetSource();
+  int count = 0;
+  for (const auto& node : collection_node_->children()) {
+    if (layout_manager_->CanBeVisible(node->view()) &&
+        controller->IsWorkspacePinned(GetFirstTab(*node)) &&
+        !ContainsActiveTab(*node)) {
+      count++;
+    }
+  }
+  return count;
