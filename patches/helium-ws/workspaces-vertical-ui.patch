+// Shows the workspace context menu (edit, new, close) and the edit bubble.
+class WorkspaceMenu : public ui::SimpleMenuModel::Delegate {
+ public:
+  explicit WorkspaceMenu(workspaces::WorkspaceController* controller)
+      : controller_(controller) {}
+  WorkspaceMenu(const WorkspaceMenu&) = delete;
+  WorkspaceMenu& operator=(const WorkspaceMenu&) = delete;
+  ~WorkspaceMenu() override = default;
+
+  bool IsRunning() const { return runner_ && runner_->IsRunning(); }
+
+  void Show(views::View* anchor,
+            const std::string& workspace_id,
+            const gfx::Rect& bounds,
+            views::MenuAnchorPosition position,
+            ui::mojom::MenuSourceType source_type) {
+    workspace_id_ = workspace_id;
+    anchor_.SetView(anchor);
+    model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    model_->AddItemWithStringId(kEditCommand, IDS_WORKSPACE_EDIT);
+    model_->AddItemWithStringId(kNewCommand, IDS_WORKSPACE_NEW_TOOLTIP);
+    model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    model_->AddItemWithStringId(kCloseCommand, IDS_WORKSPACE_CLOSE);
+    runner_ = std::make_unique<views::MenuRunner>(
+        model_.get(),
+        views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+    runner_->RunMenuAt(anchor->GetWidget(), nullptr, bounds, position,
+                       source_type);
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override {
+    return command_id != kCloseCommand ||
+           controller_->GetWorkspaces().size() > 1;
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    switch (command_id) {
+      case kEditCommand:
+        ShowEditor();
+        break;
+      case kNewCommand:
+        controller_->CreateWorkspace();
+        break;
+      case kCloseCommand:
+        controller_->CloseWorkspace(workspace_id_);
+        break;
+    }
+  }
+
+ private:
+  void ShowEditor() {
+    const auto& workspaces = controller_->GetWorkspaces();
+    const auto it = std::ranges::find(workspaces, workspace_id_,
+                                      &workspaces::Workspace::id);
+    if (it == workspaces.end() || !anchor_.view()) {
+      return;
+    }
+    auto icon_row = std::make_unique<views::FlexLayoutView>();
+    WorkspaceIconButton* icon_button = icon_row->AddChildView(
+        std::make_unique<WorkspaceIconButton>(IconText(*it)));
+    editor_accepted_ = false;
+    auto picker = std::make_unique<workspaces::WorkspaceThemePicker>(
+        it->theme, base::BindRepeating(&WorkspaceMenu::PreviewTheme,
+                                       weak_factory_.GetWeakPtr(), it->id));
+    const workspaces::WorkspaceThemePicker* theme_picker = picker.get();
+    auto model_holder = std::make_unique<raw_ptr<ui::DialogModel>>();
+    raw_ptr<ui::DialogModel>* model_ptr = model_holder.get();
+    std::unique_ptr<ui::DialogModel> model =
+        ui::DialogModel::Builder()
+            .SetTitle(l10n_util::GetStringUTF16(IDS_WORKSPACE_EDIT))
+            .SetDialogDestroyingCallback(base::BindOnce(
+                &WorkspaceMenu::OnEditorClosed, weak_factory_.GetWeakPtr(),
+                it->id, it->theme, KeepTabStripState(anchor_.view())))
+            .AddCustomField(
+                std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                    std::move(icon_row),
+                    views::BubbleDialogModelHost::FieldType::kControl,
+                    icon_button),
+                kWorkspaceIconFieldId)
+            .AddTextfield(kWorkspaceNameFieldId,
+                          l10n_util::GetStringUTF16(IDS_WORKSPACE_NAME_LABEL),
+                          it->name)
+            .AddCustomField(
+                std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                    std::move(picker),
+                    views::BubbleDialogModelHost::FieldType::kControl),
+                kWorkspaceThemeFieldId)
+            .AddOkButton(base::BindOnce(
+                &WorkspaceMenu::ApplyEdit, weak_factory_.GetWeakPtr(), it->id,
+                std::move(model_holder), icon_button, theme_picker))
+            .AddCancelButton(base::DoNothing())
+            .SetInitiallyFocusedField(kWorkspaceNameFieldId)
+            .Build();
+    *model_ptr = model.get();
+    auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+        std::move(model), anchor_.view(), views::BubbleBorder::TOP_LEFT);
+    views::BubbleDialogDelegate::CreateBubbleDeprecated(
+        std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+        ->Show();
+  }
+
+  // Returns a copy of the workspace with `id`, if it still exists.
+  std::optional<workspaces::Workspace> FindWorkspace(const std::string& id) {
+    const auto& workspaces = controller_->GetWorkspaces();
+    const auto it =
+        std::ranges::find(workspaces, id, &workspaces::Workspace::id);
+    if (it == workspaces.end()) {
+      return std::nullopt;
+    }
+    return *it;
+  }
+
+  // Shows `theme` on the workspace while its editor is open.
+  void PreviewTheme(const std::string& id,
+                    const workspaces::WorkspaceTheme& theme) {
+    std::optional<workspaces::Workspace> workspace = FindWorkspace(id);
+    if (!workspace || workspace->theme == theme) {
+      return;
+    }
+    workspace->theme = theme;
+    controller_->UpdateWorkspace(*workspace);
+  }
+
+  // Restores the theme previewed by a canceled editor.
+  void OnEditorClosed(const std::string& id,
+                      const workspaces::WorkspaceTheme& original,
+                      std::unique_ptr<ExpandOnHoverLock> lock) {
+    if (!editor_accepted_) {
+      PreviewTheme(id, original);
+    }
+  }
+
+  void ApplyEdit(const std::string& id,
+                 std::unique_ptr<raw_ptr<ui::DialogModel>> model,
+                 const WorkspaceIconButton* icon,
+                 const workspaces::WorkspaceThemePicker* theme_picker) {
+    editor_accepted_ = true;
+    std::optional<workspaces::Workspace> found = FindWorkspace(id);
+    if (!found) {
+      return;
+    }
+    workspaces::Workspace& workspace = *found;
+    ui::DialogModel* dialog = model->get();
+    const std::u16string name = std::u16string(base::TrimWhitespace(
+        dialog->GetTextfieldByUniqueId(kWorkspaceNameFieldId)->text(),
+        base::TRIM_ALL));
+    if (!name.empty()) {
+      workspace.name = name;
+    }
+    workspace.icon = icon->icon();
+    workspace.theme = theme_picker->theme();
+    controller_->UpdateWorkspace(workspace);
+  }
+
+  const raw_ptr<workspaces::WorkspaceController> controller_;
+  std::string workspace_id_;
+  views::ViewTracker anchor_;
+  std::unique_ptr<ui::SimpleMenuModel> model_;
+  std::unique_ptr<views::MenuRunner> runner_;
+  bool editor_accepted_ = false;
+  base::WeakPtrFactory<WorkspaceMenu> weak_factory_{this};
+};
