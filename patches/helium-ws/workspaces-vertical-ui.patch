+WorkspaceThemePicker::WorkspaceThemePicker(const WorkspaceTheme& theme,
+                                           ChangedCallback callback)
+    : theme_(theme), callback_(std::move(callback)) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+
+  auto wheel_row = std::make_unique<views::BoxLayoutView>();
+  wheel_row->SetMainAxisAlignment(views::BoxLayout::MainAxisAlignment::kCenter);
+  wheel_ = wheel_row->AddChildView(std::make_unique<ColorWheel>(
+      base::BindRepeating(&WorkspaceThemePicker::SetColors,
+                          base::Unretained(this))));
+  AddChildView(std::move(wheel_row));
+
+  auto buttons = std::make_unique<views::BoxLayoutView>();
+  buttons->SetMainAxisAlignment(views::BoxLayout::MainAxisAlignment::kCenter);
+  buttons->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  buttons->SetBetweenChildSpacing(4);
+  const auto add_icon_button = [&](const gfx::VectorIcon& icon, int label,
+                                   void (WorkspaceThemePicker::*method)()) {
+    auto button = views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(method, base::Unretained(this)), icon,
+        kButtonIconSize);
+    button->SetTooltipText(l10n_util::GetStringUTF16(label));
+    button->GetViewAccessibility().SetName(l10n_util::GetStringUTF16(label));
+    return buttons->AddChildView(std::move(button));
+  };
+  remove_button_ = add_icon_button(vector_icons::kCloseIcon,
+                                   IDS_WORKSPACE_THEME_REMOVE_COLOR,
+                                   &WorkspaceThemePicker::RemoveColor);
+  add_button_ =
+      add_icon_button(vector_icons::kAdd2Icon, IDS_WORKSPACE_THEME_ADD_COLOR,
+                      &WorkspaceThemePicker::AddColor);
+  for (size_t i = 0; i < kModes.size(); ++i) {
+    mode_buttons_[i] = buttons->AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&WorkspaceThemePicker::SetMode,
+                            base::Unretained(this), kModes[i].first),
+        l10n_util::GetStringUTF16(kModes[i].second)));
+  }
+  AddChildView(std::move(buttons));
+
+  auto intensity_row = std::make_unique<views::BoxLayoutView>();
+  intensity_row->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  intensity_row->SetBetweenChildSpacing(8);
+  const std::u16string intensity_label =
+      l10n_util::GetStringUTF16(IDS_WORKSPACE_THEME_INTENSITY);
+  intensity_row->AddChildView(std::make_unique<views::Label>(intensity_label));
+  intensity_ =
+      intensity_row->AddChildView(std::make_unique<views::Slider>(this));
+  intensity_->SetValue(theme_.intensity);
+  intensity_->GetViewAccessibility().SetName(intensity_label);
+  intensity_row->SetFlexForView(intensity_, 1);
+  AddChildView(std::move(intensity_row));
+
+  grain_ = AddChildView(std::make_unique<views::Checkbox>(
+      l10n_util::GetStringUTF16(IDS_WORKSPACE_THEME_GRAIN),
+      base::BindRepeating(&WorkspaceThemePicker::ToggleGrain,
+                          base::Unretained(this))));
+  grain_->SetChecked(theme_.grain);
+
+  UpdateControls();
+}
+
+WorkspaceThemePicker::~WorkspaceThemePicker() = default;
+
+void WorkspaceThemePicker::SliderValueChanged(
+    views::Slider* sender,
+    float value,
+    float old_value,
+    views::SliderChangeReason reason) {
+  if (reason != views::SliderChangeReason::kByUser) {
+    return;
+  }
+  theme_.intensity = value;
+  NotifyChanged(false);
+}
+
+void WorkspaceThemePicker::SliderDragEnded(views::Slider* sender) {
+  NotifyChanged(true);
+}
+
+void WorkspaceThemePicker::SetColors(std::vector<SkColor> colors, bool final) {
+  const bool count_changed = colors.size() != theme_.colors.size();
+  theme_.colors = std::move(colors);
+  if (count_changed) {
+    UpdateControls();
+  }
+  NotifyChanged(final);
+}
+
+void WorkspaceThemePicker::AddColor() {
+  if (theme_.colors.size() >= kMaxThemeColors) {
+    return;
+  }
+  theme_.colors.push_back(
+      theme_.colors.empty()
+          ? kDefaultColor
+          : RotateHue(theme_.colors.front(), 120.0f * theme_.colors.size()));
+  UpdateControls();
+  NotifyChanged(true);
+}
+
+void WorkspaceThemePicker::RemoveColor() {
+  if (theme_.colors.empty()) {
+    return;
+  }
+  theme_.colors.pop_back();
+  UpdateControls();
+  NotifyChanged(true);
+}
+
+void WorkspaceThemePicker::SetMode(WorkspaceColorMode mode) {
+  theme_.mode = mode;
+  UpdateControls();
+  NotifyChanged(true);
+}
+
+void WorkspaceThemePicker::ToggleGrain() {
+  theme_.grain = grain_->GetChecked();
+  NotifyChanged(true);
+}
+
+void WorkspaceThemePicker::UpdateControls() {
+  wheel_->SetColors(theme_.colors);
+  add_button_->SetEnabled(theme_.colors.size() < kMaxThemeColors);
+  remove_button_->SetEnabled(!theme_.colors.empty());
+  const bool has_colors = !theme_.colors.empty();
+  for (size_t i = 0; i < kModes.size(); ++i) {
+    mode_buttons_[i]->SetStyle(kModes[i].first == theme_.mode
+                                   ? ui::ButtonStyle::kTonal
+                                   : ui::ButtonStyle::kText);
+  }
+  intensity_->SetEnabled(has_colors);
+  grain_->SetEnabled(has_colors);
+}
+
+void WorkspaceThemePicker::NotifyChanged(bool final) {
+  if (final) {
+    throttle_.Stop();
+    RunCallback();
+  } else if (!throttle_.IsRunning()) {
+    throttle_.Start(FROM_HERE, kThrottle,
+                    base::BindOnce(&WorkspaceThemePicker::RunCallback,
+                                   base::Unretained(this)));
+  }
+}
+
+void WorkspaceThemePicker::RunCallback() {
+  callback_.Run(theme_);
+}
+
+BEGIN_METADATA(WorkspaceThemePicker)
+END_METADATA
+
+}  // namespace workspaces
