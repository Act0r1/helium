+#ifndef CHROME_BROWSER_UI_VIEWS_WORKSPACES_WORKSPACE_BACKGROUND_H_
+#define CHROME_BROWSER_UI_VIEWS_WORKSPACES_WORKSPACE_BACKGROUND_H_
+
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/workspaces/workspace_controller.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/animation/animation_delegate.h"
+#include "ui/gfx/animation/slide_animation.h"
+
+class BrowserView;
+
+namespace gfx {
+class Canvas;
+}
+
+namespace views {
+class View;
+}
+
+namespace workspaces {
+
+// Paints the gradient and grain of the active workspace theme behind the
+// browser chrome, aligned to the BrowserView so that all chrome views share
+// one gradient. Cross-fades the background when another workspace becomes
+// active, and applies theme changes to the browser color palette.
+class WorkspaceBackground : public WorkspaceController::Observer,
+                            public gfx::AnimationDelegate {
+ public:
+  WorkspaceBackground(BrowserView* browser_view,
+                      WorkspaceController* controller);
+  WorkspaceBackground(const WorkspaceBackground&) = delete;
+  WorkspaceBackground& operator=(const WorkspaceBackground&) = delete;
+  ~WorkspaceBackground() override;
+
+  // Paints the background of `view` over `base`, the solid chrome color.
+  // Returns false when no workspace theme is shown and nothing was painted.
+  bool Paint(gfx::Canvas* canvas, const views::View* view, SkColor base) const;
+
+  // Returns whether a workspace theme is shown, so the chrome around the web
+  // contents lets the gradient through.
+  bool IsThemeShown() const { return !shown_theme_.colors.empty(); }
+
+  // WorkspaceController::Observer:
+  void OnWorkspacesChanged() override;
+  void OnActiveWorkspaceChanged() override;
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  struct Look {
+    SkColor base = SK_ColorTRANSPARENT;
+    WorkspaceTheme theme;
+  };
+
+  void Sync();
+  void SchedulePaintChrome();
+
+  const raw_ptr<BrowserView> browser_view_;
+  const raw_ptr<WorkspaceController> controller_;
+  std::string shown_id_;
+  WorkspaceTheme shown_theme_;
+  // The look painted before the active workspace changed, faded out by
+  // `animation_`.
+  std::optional<Look> previous_;
+  // The base color of the last paint, which `previous_` keeps on a switch.
+  mutable SkColor last_base_ = SK_ColorTRANSPARENT;
+  gfx::SlideAnimation animation_{this};
+  base::ScopedObservation<WorkspaceController, WorkspaceController::Observer>
+      observation_{this};
+};
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_WORKSPACES_WORKSPACE_BACKGROUND_H_
