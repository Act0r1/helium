+WorkspaceBackground::WorkspaceBackground(BrowserView* browser_view,
+                                         WorkspaceController* controller)
+    : browser_view_(browser_view), controller_(controller) {
+  animation_.SetSlideDuration(kCrossFadeDuration);
+  animation_.SetTweenType(gfx::Tween::EASE_IN_OUT);
+  if (const Workspace* active = controller_->GetActiveWorkspace()) {
+    shown_id_ = active->id;
+  }
+  if (const WorkspaceTheme* theme = controller_->GetShownTheme()) {
+    shown_theme_ = *theme;
+  }
+  observation_.Observe(controller_);
+}
+
+WorkspaceBackground::~WorkspaceBackground() = default;
+
+bool WorkspaceBackground::Paint(gfx::Canvas* canvas,
+                                const views::View* view,
+                                SkColor base) const {
+  const bool fading = previous_ && animation_.is_animating();
+  if (!fading) {
+    last_base_ = base;
+  }
+  if (shown_theme_.colors.empty() && !fading) {
+    return false;
+  }
+
+  gfx::Point origin;
+  views::View::ConvertPointToTarget(browser_view_, view, &origin);
+  const gfx::Rect area(origin, browser_view_->size());
+  const SkPath& clip_path = view->clip_path();
+  const gfx::Rect bounds =
+      clip_path.isEmpty()
+          ? view->GetLocalBounds()
+          : gfx::ToEnclosingRect(gfx::SkRectToRectF(clip_path.getBounds()));
+
+  if (!fading) {
+    PaintLook(canvas, bounds, area, base, shown_theme_);
+    return true;
+  }
+  PaintLook(canvas, bounds, area, previous_->base, previous_->theme);
+  canvas->SaveLayerAlpha(
+      static_cast<uint8_t>(animation_.GetCurrentValue() * 255), bounds);
+  PaintLook(canvas, bounds, area, base, shown_theme_);
+  canvas->Restore();
+  return true;
+}
+
+void WorkspaceBackground::OnWorkspacesChanged() {
+  Sync();
+}
+
+void WorkspaceBackground::OnActiveWorkspaceChanged() {
+  Sync();
+}
+
+void WorkspaceBackground::AnimationProgressed(const gfx::Animation* animation) {
+  SchedulePaintChrome();
+}
+
+void WorkspaceBackground::AnimationEnded(const gfx::Animation* animation) {
+  previous_.reset();
+  SchedulePaintChrome();
+}
+
+void WorkspaceBackground::Sync() {
+  const Workspace* active = controller_->GetActiveWorkspace();
+  const std::string id = active ? active->id : std::string();
+  const WorkspaceTheme* shown = controller_->GetShownTheme();
+  const WorkspaceTheme theme = shown ? *shown : WorkspaceTheme();
+  if (id == shown_id_ && theme == shown_theme_) {
+    return;
+  }
+
+  if (id != shown_id_ && browser_view_->GetWidget() &&
+      browser_view_->GetWidget()->IsVisible()) {
+    previous_ = Look{last_base_, shown_theme_};
+    animation_.Reset();
+    animation_.Show();
+  }
+  const bool was_shown = IsThemeShown();
+  shown_id_ = id;
+  shown_theme_ = theme;
+  if (views::Widget* widget = browser_view_->GetWidget()) {
+    widget->ThemeChanged();
+  }
+  if (was_shown != IsThemeShown() && browser_view_->multi_contents_view()) {
+    browser_view_->multi_contents_view()->InvalidateLayout();
+  }
+  SchedulePaintChrome();
+}
+
+void WorkspaceBackground::SchedulePaintChrome() {
+  browser_view_->SchedulePaint();
+  SchedulePaintLayers(browser_view_);
+}
+
+}  // namespace workspaces
