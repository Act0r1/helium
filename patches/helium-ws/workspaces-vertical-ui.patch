+constexpr base::TimeDelta kCrossFadeDuration = base::Milliseconds(320);
+constexpr int kGrainSize = 128;
+constexpr uint8_t kGrainAlpha = 0x1C;
+
+// Returns a tile of deterministic monochrome noise.
+const gfx::ImageSkia& GrainTile() {
+  static const base::NoDestructor<gfx::ImageSkia> tile([] {
+    SkBitmap bitmap;
+    bitmap.allocN32Pixels(kGrainSize, kGrainSize);
+    uint32_t state = 0x2545F491;
+    for (int y = 0; y < kGrainSize; ++y) {
+      for (int x = 0; x < kGrainSize; ++x) {
+        state = state * 1664525u + 1013904223u;
+        const uint8_t value = state >> 24;
+        *bitmap.getAddr32(x, y) = SkPreMultiplyARGB(0xFF, value, value, value);
+      }
+    }
+    bitmap.setImmutable();
+    return gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+  }());
+  return *tile;
+}
+
+// Paints `theme` over `base` into `bounds` of `canvas`, with the vertical
+// gradient spanning `area`, the BrowserView bounds in canvas coordinates.
+void PaintLook(gfx::Canvas* canvas,
+               const gfx::Rect& bounds,
+               const gfx::Rect& area,
+               SkColor base,
+               const WorkspaceTheme& theme) {
+  canvas->DrawColor(base);
+  if (theme.colors.empty()) {
+    return;
+  }
+
+  const float alpha = 0.25f + 0.55f * theme.intensity;
+  std::vector<SkColor4f> colors;
+  if (theme.colors.size() == 1) {
+    SkColor4f color = SkColor4f::FromColor(theme.colors.front());
+    colors.push_back(color.makeOpaque());
+    colors.back().fA = alpha;
+    colors.push_back(color.makeOpaque());
+    colors.back().fA = alpha * 0.35f;
+  } else {
+    for (SkColor color : theme.colors) {
+      colors.push_back(SkColor4f::FromColor(color).makeOpaque());
+      colors.back().fA = alpha;
+    }
+  }
+  const SkPoint points[] = {SkPoint::Make(area.x(), area.y()),
+                            SkPoint::Make(area.x(), area.bottom())};
+  cc::PaintFlags flags;
+  flags.setShader(cc::PaintShader::MakeLinearGradient(
+      points, colors.data(), nullptr, static_cast<int>(colors.size()),
+      SkTileMode::kClamp));
+  canvas->DrawRect(bounds, flags);
+
+  if (theme.grain) {
+    cc::PaintFlags grain;
+    grain.setAlphaf(kGrainAlpha / 255.0f);
+    grain.setBlendMode(SkBlendMode::kOverlay);
+    canvas->TileImageInt(GrainTile(), bounds.x() - area.x(),
+                         bounds.y() - area.y(), bounds.x(), bounds.y(),
+                         bounds.width(), bounds.height(), 1.0f,
+                         SkTileMode::kRepeat, SkTileMode::kRepeat, &grain);
+  }
+}
+
+// Schedules a paint of `view` and every descendant painted into its own layer.
+void SchedulePaintLayers(views::View* view) {
+  if (view->layer()) {
+    view->SchedulePaint();
+  }
+  for (views::View* child : view->children()) {
+    SchedulePaintLayers(child);
+  }
+}
