+// Lets the location bar take the tone of the workspace theme gradient painted
+// behind the browser chrome, and the new tab page show it through with tinted
+// shortcut tiles.
+class WorkspaceColorMixers : public ui::ColorProviderKey::InitializerSupplier {
+ public:
+  static WorkspaceColorMixers* Get() {
+    static base::NoDestructor<WorkspaceColorMixers> instance;
+    return instance.get();
+  }
+
+  ~WorkspaceColorMixers() override = default;
+
+  // ui::ColorProviderKey::InitializerSupplier:
+  void AddColorMixers(ui::ColorProvider* provider,
+                      const ui::ColorProviderKey& key) const override {
+    ui::ColorMixer& mixer = provider->AddMixer();
+    mixer[kColorLocationBarBackground] =
+        ui::SetAlpha({ui::kColorSysOnSurface}, 0x14);
+    mixer[kColorLocationBarBackgroundHovered] =
+        ui::SetAlpha({ui::kColorSysOnSurface}, 0x1F);
+    mixer[kColorNewTabPageBackground] = {SK_ColorTRANSPARENT};
