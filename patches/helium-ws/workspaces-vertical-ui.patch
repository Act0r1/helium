+bool ContainsActiveTab(const TabCollectionNode& node) {
+  if (node.type() == TabCollectionNode::Type::TAB) {
+    return std::get<tabs::ConstDanglingUntriagedTabInterface>(
+               node.GetNodeData())
+        ->IsActivated();
+  }
+  return std::ranges::any_of(node.children(), [](const auto& child) {
+    return ContainsActiveTab(*child);
