+// A hue and saturation wheel with one draggable point per theme color.
+class WorkspaceThemePicker::ColorWheel : public views::View {
+  METADATA_HEADER(ColorWheel, views::View)
+
+ public:
+  using ColorsCallback =
+      base::RepeatingCallback<void(std::vector<SkColor>, bool final)>;
+
+  explicit ColorWheel(ColorsCallback callback)
+      : callback_(std::move(callback)) {
+    SetPreferredSize(gfx::Size(kWheelSize, kWheelSize));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_WORKSPACE_THEME_LABEL));
+  }
+  ColorWheel(const ColorWheel&) = delete;
+  ColorWheel& operator=(const ColorWheel&) = delete;
+  ~ColorWheel() override = default;
+
+  void SetColors(const std::vector<SkColor>& colors) {
+    colors_ = colors;
+    SchedulePaint();
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::PointF center = Center();
+    const float radius = Radius();
+
+    std::vector<SkColor4f> hues;
+    for (int hue = 0; hue <= 360; hue += 30) {
+      const SkScalar hsv[3] = {static_cast<SkScalar>(hue % 360), 1.0f,
+                               kWheelValue};
+      hues.push_back(SkColor4f::FromColor(SkHSVToColor(hsv)));
+    }
+    cc::PaintFlags wheel;
+    wheel.setAntiAlias(true);
+    wheel.setShader(cc::PaintShader::MakeSweepGradient(
+        center.x(), center.y(), hues.data(), nullptr,
+        static_cast<int>(hues.size()),
+        SkTileMode::kClamp, 0, 360));
+    canvas->DrawCircle(center, radius, wheel);
+
+    const SkColor4f white =
+        SkColor4f::FromColor(SkColorSetRGB(0xF2, 0xF2, 0xF2));
+    SkColor4f faded = white;
+    faded.fA = 0;
+    const SkColor4f radial[] = {white, faded};
+    cc::PaintFlags fade;
+    fade.setAntiAlias(true);
+    fade.setShader(cc::PaintShader::MakeRadialGradient(
+        SkPoint::Make(center.x(), center.y()), radius, radial, nullptr, 2,
+        SkTileMode::kClamp));
+    canvas->DrawCircle(center, radius, fade);
+
+    for (size_t i = 0; i < colors_.size(); ++i) {
+      const gfx::PointF point = PointOf(colors_[i]);
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(SkColorSetA(SK_ColorBLACK, 0x40));
+      canvas->DrawCircle(point, kHandleRadius + 1.5f, flags);
+      flags.setColor(SK_ColorWHITE);
+      canvas->DrawCircle(point, kHandleRadius, flags);
+      flags.setColor(colors_[i]);
+      canvas->DrawCircle(point, kHandleRadius - (i == 0 ? 2.0f : 3.0f), flags);
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    const gfx::PointF location = event.location_f();
+    dragged_ = Nearest(location);
+    if (!dragged_) {
+      if (colors_.empty()) {
+        colors_.push_back(kDefaultColor);
+        dragged_ = 0;
+      } else {
+        dragged_ = NearestAny(location);
+      }
+    }
+    MoveDragged(location, false);
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    MoveDragged(event.location_f(), false);
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    MoveDragged(event.location_f(), true);
+    dragged_.reset();
+  }
+
+  void OnMouseCaptureLost() override {
+    if (dragged_) {
+      callback_.Run(colors_, true);
+    }
+    dragged_.reset();
+  }
+
+ private:
+  gfx::PointF Center() const {
+    return gfx::PointF(width() / 2.0f, height() / 2.0f);
+  }
+
+  float Radius() const {
+    return std::min(width(), height()) / 2.0f - kHandleRadius - 2;
+  }
+
+  gfx::PointF PointOf(SkColor color) const {
+    SkScalar hsv[3];
+    SkColorToHSV(color, hsv);
+    const double angle = base::DegToRad(static_cast<double>(hsv[0]));
+    const float distance = hsv[1] * Radius();
+    return Center() + gfx::Vector2dF(distance * std::cos(angle),
+                                     distance * std::sin(angle));
+  }
+
+  // Returns the point within grab distance of `location`.
+  std::optional<size_t> Nearest(const gfx::PointF& location) const {
+    std::optional<size_t> nearest = NearestAny(location);
+    if (nearest && (PointOf(colors_[*nearest]) - location).Length() >
+                       kGrabDistance) {
+      return std::nullopt;
+    }
+    return nearest;
+  }
+
+  std::optional<size_t> NearestAny(const gfx::PointF& location) const {
+    std::optional<size_t> nearest;
+    float best = 0;
+    for (size_t i = 0; i < colors_.size(); ++i) {
+      const float distance = (PointOf(colors_[i]) - location).Length();
+      if (!nearest || distance < best) {
+        nearest = i;
+        best = distance;
+      }
+    }
+    return nearest;
+  }
+
+  void MoveDragged(const gfx::PointF& location, bool final) {
+    if (!dragged_ || *dragged_ >= colors_.size()) {
+      return;
+    }
+    const gfx::Vector2dF offset = location - Center();
+    float hue = base::RadToDeg(std::atan2(offset.y(), offset.x()));
+    if (hue < 0) {
+      hue += 360;
+    }
+    const float saturation = std::clamp(offset.Length() / Radius(), 0.0f, 1.0f);
+    const SkScalar hsv[3] = {hue, saturation, kWheelValue};
+    colors_[*dragged_] = SkHSVToColor(hsv);
+    SchedulePaint();
+    callback_.Run(colors_, final);
+  }
+
+  ColorsCallback callback_;
+  std::vector<SkColor> colors_;
+  std::optional<size_t> dragged_;
+};
+
+BEGIN_METADATA(WorkspaceThemePicker, ColorWheel)
+END_METADATA
