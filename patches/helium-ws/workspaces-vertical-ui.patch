+// Keeps the vertical tab strip from collapsing on hover-out while a bubble
+// anchored in it is open. Returns null if `anchor` is not in a browser window.
+std::unique_ptr<ExpandOnHoverLock> KeepTabStripState(views::View* anchor) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForNativeWindow(
+      anchor->GetWidget()->GetNativeWindow());
+  if (!browser_view || !browser_view->tab_strip_view()) {
+    return nullptr;
+  }
+  return browser_view->tab_strip_view()->GetExpandOnHoverLock(
+      ExpandOnHoverLockType::kKeepCurrentState);
+}
