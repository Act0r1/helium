+// Shows the icon picker below `anchor`. Keeps a bubble that contains `anchor`
+// open while the picker has focus.
+void ShowIconPicker(views::View* anchor,
+                    std::u16string_view selected_icon,
+                    IconPickedCallback callback) {
+  std::unique_ptr<views::BubbleDialogDelegate::CloseOnDeactivatePin> pin;
+  if (auto* parent =
+          anchor->GetWidget()->widget_delegate()->AsBubbleDialogDelegate()) {
+    pin = parent->PreventCloseOnDeactivate();
+  }
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetAccessibleTitle(
+              l10n_util::GetStringUTF16(IDS_WORKSPACE_ICON_LABEL))
+          .OverrideShowCloseButton(false)
+          .SetDialogDestroyingCallback(
+              base::DoNothingWithBoundArgs(KeepTabStripState(anchor)))
+          .AddCustomField(
+              std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                  std::make_unique<WorkspaceIconGrid>(
+                      selected_icon, std::move(callback), std::move(pin)),
+                  views::BubbleDialogModelHost::FieldType::kControl))
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::TOP_LEFT);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
