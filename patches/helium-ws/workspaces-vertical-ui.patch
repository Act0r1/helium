+#ifndef CHROME_BROWSER_UI_VIEWS_WORKSPACES_WORKSPACE_THEME_PICKER_H_
+#define CHROME_BROWSER_UI_VIEWS_WORKSPACES_WORKSPACE_THEME_PICKER_H_
+
+#include <array>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/workspaces/workspace_controller.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/slider.h"
+#include "ui/views/view.h"
+
+namespace views {
+class Checkbox;
+class ImageButton;
+class MdTextButton;
+}  // namespace views
+
+namespace workspaces {
+
+// Edits a workspace theme: a color wheel with up to `kMaxThemeColors`
+// draggable points, the color mode, the intensity and the grain. Reports every
+// change, throttled while dragging, so the browser can preview it live.
+class WorkspaceThemePicker : public views::View, public views::SliderListener {
+  METADATA_HEADER(WorkspaceThemePicker, views::View)
+
+ public:
+  using ChangedCallback = base::RepeatingCallback<void(const WorkspaceTheme&)>;
+
+  WorkspaceThemePicker(const WorkspaceTheme& theme, ChangedCallback callback);
+  WorkspaceThemePicker(const WorkspaceThemePicker&) = delete;
+  WorkspaceThemePicker& operator=(const WorkspaceThemePicker&) = delete;
+  ~WorkspaceThemePicker() override;
+
+  const WorkspaceTheme& theme() const { return theme_; }
+
+  // views::SliderListener:
+  void SliderValueChanged(views::Slider* sender,
+                          float value,
+                          float old_value,
+                          views::SliderChangeReason reason) override;
+  void SliderDragEnded(views::Slider* sender) override;
+
+ private:
+  class ColorWheel;
+
+  void SetColors(std::vector<SkColor> colors, bool final);
+  void AddColor();
+  void RemoveColor();
+  void SetMode(WorkspaceColorMode mode);
+  void ToggleGrain();
+  void UpdateControls();
+  // Reports the theme now if `final`, otherwise at most once per throttle
+  // interval.
+  void NotifyChanged(bool final);
+  void RunCallback();
+
+  WorkspaceTheme theme_;
+  ChangedCallback callback_;
+  base::OneShotTimer throttle_;
+  raw_ptr<ColorWheel> wheel_ = nullptr;
+  raw_ptr<views::ImageButton> add_button_ = nullptr;
+  raw_ptr<views::ImageButton> remove_button_ = nullptr;
+  std::array<raw_ptr<views::MdTextButton>, 3> mode_buttons_;
+  raw_ptr<views::Slider> intensity_ = nullptr;
+  raw_ptr<views::Checkbox> grain_ = nullptr;
+};
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_WORKSPACES_WORKSPACE_THEME_PICKER_H_
