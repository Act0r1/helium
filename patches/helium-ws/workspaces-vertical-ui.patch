+const gfx::VectorIcon* VectorIconFor(std::u16string_view icon) {
+  const auto it = std::ranges::find(workspaces::kWorkspaceIcons, icon);
+  if (it == workspaces::kWorkspaceIcons.end()) {
+    return nullptr;
+  }
+  return workspaces::kWorkspaceVectorIcons[it -
