+// The row of workspace icons at the bottom of the vertical tab strip.
+class WorkspaceSwitcherView : public views::FlexLayoutView,
+                              public workspaces::WorkspaceController::Observer {
+  METADATA_HEADER(WorkspaceSwitcherView, views::FlexLayoutView)
+
+ public:
+  explicit WorkspaceSwitcherView(BrowserWindowInterface* browser)
+      : browser_(browser),
+        controller_(workspaces::WorkspaceController::From(browser)) {
+    CHECK(controller_);
+    SetOrientation(views::LayoutOrientation::kHorizontal);
+    SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    SetInteriorMargin(gfx::Insets::VH(6, 0));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kToolbar);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_WORKSPACE_SWITCHER_ACCNAME));
+
+    auto chips = std::make_unique<views::FlexLayoutView>();
+    chips->SetOrientation(views::LayoutOrientation::kHorizontal);
+    chips->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    chips->SetMainAxisAlignment(views::LayoutAlignment::kCenter);
+    chips->SetDefault(views::kMarginsKey, gfx::Insets::VH(0, 2));
+    chips->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                                 views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    chips_ = AddChildView(std::move(chips));
+
+    const std::u16string new_workspace_label =
+        l10n_util::GetStringUTF16(IDS_WORKSPACE_NEW_TOOLTIP);
+    auto add_button = views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(&WorkspaceSwitcherView::CreateNewWorkspace,
+                            base::Unretained(this)),
+        vector_icons::kAdd2Icon, kAddIconSize);
+    add_button->SetBorder(views::CreateEmptyBorder(0));
+    add_button->SetPreferredSize(gfx::Size(kAddButtonSize, kAddButtonSize));
+    views::InstallRoundRectHighlightPathGenerator(
+        add_button.get(), gfx::Insets(), kCornerRadius);
+    views::InkDrop::Get(add_button.get())->SetHighlightOpacity(0.16f);
+    add_button->SetTooltipText(new_workspace_label);
+    add_button->GetViewAccessibility().SetName(new_workspace_label);
+    add_button_ = AddChildView(std::move(add_button));
+
+    if (auto* state = tabs::VerticalTabStripStateController::From(browser)) {
+      collapse_changed_subscription_ = state->RegisterOnCollapseChanged(
+          base::BindRepeating(&WorkspaceSwitcherView::OnCollapseChanged,
+                              base::Unretained(this)));
+    }
+
+    controller_observation_.Observe(controller_);
+    Rebuild();
+  }
+
+  WorkspaceSwitcherView(const WorkspaceSwitcherView&) = delete;
+  WorkspaceSwitcherView& operator=(const WorkspaceSwitcherView&) = delete;
+  ~WorkspaceSwitcherView() override = default;
+
+  void OnWorkspacesChanged() override { ScheduleRebuild(); }
+
+  void OnActiveWorkspaceChanged() override { ScheduleRebuild(); }
+
+  void OnThemeChanged() override {
+    views::FlexLayoutView::OnThemeChanged();
+    ScheduleRebuild();
+  }
+
+ private:
+  void OnCollapseChanged(tabs::VerticalTabStripCollapseState state) {
+    ScheduleRebuild();
+  }
+
+  void ScheduleRebuild() {
+    if (rebuild_scheduled_) {
+      return;
+    }
+    rebuild_scheduled_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&WorkspaceSwitcherView::Rebuild,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Rebuild() {
+    rebuild_scheduled_ = false;
+    const bool collapsed = IsCollapsed(browser_);
+    chips_->RemoveAllChildViews();
+    add_button_->SetVisible(!collapsed);
+
+    const ui::ColorProvider* provider = GetColorProvider();
+    const workspaces::Workspace* active = controller_->GetActiveWorkspace();
+    for (const auto& workspace : controller_->GetWorkspaces()) {
+      const bool is_active = active && active->id == workspace.id;
+      if (collapsed && !is_active) {
+        continue;
+      }
+      auto chip = std::make_unique<WorkspaceChipButton>(
+          base::BindRepeating(&WorkspaceSwitcherView::ActivateWorkspace,
+                              base::Unretained(this), workspace.id),
+          IconText(workspace));
+      chip->SetTooltipText(workspace.name);
+      chip->GetViewAccessibility().SetName(l10n_util::GetStringFUTF16(
+          IDS_WORKSPACE_ITEM_ACCNAME, workspace.name));
+      if (provider) {
+        const SkColor color = WorkspaceColor(provider, workspace);
+        const SkColor text = provider->GetColor(ui::kColorLabelForeground);
+        if (is_active) {
+          chip->SetBackground(views::CreateRoundedRectBackground(
+              SkColorSetA(color, kActiveChipAlpha), kCornerRadius));
+          chip->SetIconColor(text);
+        } else {
+          chip->SetIconColor(SkColorSetA(text, kInactiveTextAlpha));
+        }
+      }
+      chips_->AddChildView(std::move(chip));
+    }
+    InvalidateLayout();
+  }
+
+  void ActivateWorkspace(const std::string& id) {
+    controller_->ActivateWorkspace(id);
+  }
+
+  void CreateNewWorkspace() { controller_->CreateWorkspace(); }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<workspaces::WorkspaceController> controller_;
+  raw_ptr<views::FlexLayoutView> chips_ = nullptr;
+  raw_ptr<views::ImageButton> add_button_ = nullptr;
+  base::CallbackListSubscription collapse_changed_subscription_;
+  base::ScopedObservation<workspaces::WorkspaceController,
+                          workspaces::WorkspaceController::Observer>
+      controller_observation_{this};
+  bool rebuild_scheduled_ = false;
+  base::WeakPtrFactory<WorkspaceSwitcherView> weak_factory_{this};
+};
