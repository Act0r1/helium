+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsWorkspacesPageElement} from './workspaces_page.js';
+
+export function getHtml(this: SettingsWorkspacesPageElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<settings-section page-title="$i18n{workspacesPageTitle}"
+    class="cr-centered-card-container">
+  <div class="cr-row first">
+    <div class="flex cr-padded-text">
+      <div>$i18n{workspaceRulesEnabled}</div>
+      <div class="secondary">$i18n{workspaceRulesEnabledSublabel}</div>
+    </div>
+    <cr-toggle id="enabledToggle" ?checked="${this.state_.enabled}"
+        aria-label="$i18n{workspaceRulesEnabled}"
+        @change="${this.onEnabledChange_}">
+    </cr-toggle>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{workspaceRulesFollow}</div>
+      <div class="secondary">$i18n{workspaceRulesFollowSublabel}</div>
+    </div>
+    <cr-toggle id="followToggle" ?checked="${this.state_.follow}"
+        ?disabled="${!this.state_.enabled}"
+        aria-label="$i18n{workspaceRulesFollow}"
+        @change="${this.onFollowChange_}">
+    </cr-toggle>
+  </div>
+
+  <div class="cr-row continuation">
+    <h2 class="cr-title-text">$i18n{workspaceRules}</h2>
+  </div>
+  <div class="list" ?inert="${!this.state_.enabled}">
+    ${this.getGroups_().map(group => html`
+      <div class="workspace" ?highlighted="${group.highlighted}"
+          data-workspace-id="${group.id}">
+        <div class="workspace-name">${group.label}</div>
+        ${group.rules.length ? html`
+          <div class="chips">
+            ${group.rules.map(rule => html`
+              <span class="chip">
+                <span class="pattern">${rule.pattern}</span>
+                <cr-icon-button class="icon-clear no-overlap"
+                    title="$i18n{workspaceRulesRemove}"
+                    aria-label="$i18n{workspaceRulesRemove} ${rule.pattern}"
+                    data-pattern="${rule.pattern}"
+                    @click="${this.onRemoveClick_}">
+                </cr-icon-button>
+              </span>
+            `)}
+          </div>
+        ` : html`
+          <div class="secondary">$i18n{workspaceRulesEmpty}</div>
+        `}
+      </div>
+    `)}
+
+    <div class="add">
+      <div class="add-row">
+        <cr-input id="patternInput" class="flex"
+            .value="${this.newPattern_}"
+            placeholder="$i18n{workspaceRulesPattern}"
+            spellcheck="false"
+            ?invalid="${this.patternInvalid_}"
+            error-message="$i18n{workspaceRulesInvalid}"
+            @value-changed="${this.onPatternValueChanged_}"
+            @keydown="${this.onPatternKeydown_}">
+        </cr-input>
+        <select class="md-select" id="workspaceSelect"
+            aria-label="$i18n{workspaceRulesWorkspace}"
+            @change="${this.onWorkspaceSelectChange_}">
+          ${this.state_.workspaces.map(workspace => html`
+            <option value="${workspace.id}"
+                ?selected="${workspace.id === this.newWorkspace_}">
+              ${this.workspaceLabel_(workspace)}
+            </option>
+          `)}
+        </select>
+        <cr-button id="addButton" class="action-button"
+            ?disabled="${!this.canAdd_()}" @click="${this.onAddClick_}">
+          $i18n{workspaceRulesAdd}
+        </cr-button>
+      </div>
+      <div class="secondary hint" ?hidden="${this.patternInvalid_}">
+        $i18n{workspaceRulesHint}
+      </div>
+    </div>
+  </div>
+
+  <div class="cr-row continuation">
+    <h2 class="cr-title-text">$i18n{workspaceRulesCheck}</h2>
+  </div>
+  <div class="list">
+    <cr-input id="checkInput" .value="${this.checkUrl_}"
+        placeholder="$i18n{workspaceRulesCheckPlaceholder}"
+        spellcheck="false"
+        @value-changed="${this.onCheckValueChanged_}">
+    </cr-input>
+    <div id="checkResult" class="secondary hint" role="status">
+      ${this.checkResult_}
+    </div>
+  </div>
+</settings-section>
+<!--_html_template_end_-->`;
+  // clang-format on
+}
diff --git a/chrome/browser/resources/settings/workspaces_page/workspaces_page.ts b/chrome/browser/resources/settings/workspaces_page/workspaces_page.ts
new file mode 100644
index 000000000..82bf9ff4b
--- /dev/null
+++ b/chrome/browser/resources/settings/workspaces_page/workspaces_page.ts
@@ -0,0 +1,247 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-workspaces-page' edits the rules that open sites in a workspace.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import '../settings_page/settings_section.js';
+
+import type {CrToggleElement} from 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+import {routes} from '../route.js';
+import {RouteObserverMixinLit, Router} from '../router.js';
+import type {Route} from '../router.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import type {WorkspaceInfo, WorkspaceRule, WorkspaceRulesState, WorkspacesBrowserProxy} from './workspaces_browser_proxy.js';
+import {WorkspacesBrowserProxyImpl} from './workspaces_browser_proxy.js';
+import {getCss} from './workspaces_page.css.js';
+import {getHtml} from './workspaces_page.html.js';
+
+interface RuleGroup {
+  id: string;
+  label: string;
+  highlighted: boolean;
+  rules: WorkspaceRule[];
+}
+
+const SettingsWorkspacesPageElementBase =
+    RouteObserverMixinLit(WebUiListenerMixinLit(CrLitElement));
+
+export class SettingsWorkspacesPageElement extends
+    SettingsWorkspacesPageElementBase implements SettingsPlugin {
+  static get is() {
+    return 'settings-workspaces-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      state_: {type: Object},
+      highlightedId_: {type: String},
+      newPattern_: {type: String},
+      newWorkspace_: {type: String},
+      patternInvalid_: {type: Boolean},
+      checkUrl_: {type: String},
+      checkResult_: {type: String},
+    };
+  }
+
+  protected accessor state_: WorkspaceRulesState =
+      {enabled: true, follow: true, workspaces: [], rules: []};
+  protected accessor highlightedId_: string = '';
+  protected accessor newPattern_: string = '';
+  protected accessor newWorkspace_: string = '';
+  protected accessor patternInvalid_: boolean = false;
+  protected accessor checkUrl_: string = '';
+  protected accessor checkResult_: string = '';
+
+  private browserProxy_: WorkspacesBrowserProxy =
+      WorkspacesBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'workspace-rules-changed', this.onStateChanged_.bind(this));
+    document.addEventListener('visibilitychange', this.onVisibilityChange_);
+    this.refresh_();
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    document.removeEventListener('visibilitychange', this.onVisibilityChange_);
+  }
+
+  private onVisibilityChange_ = () => {
+    if (document.visibilityState === 'visible') {
+      this.browserProxy_.getState().then(this.onStateChanged_.bind(this));
+    }
+  };
+
+  override currentRouteChanged(newRoute: Route) {
+    if (newRoute !== routes.WORKSPACES) {
+      return;
+    }
+    this.highlightedId_ =
+        Router.getInstance().getQueryParameters().get('id') || '';
+    if (this.highlightedId_) {
+      this.newWorkspace_ = this.highlightedId_;
+    }
+    this.refresh_();
+  }
+
+  private async refresh_() {
+    this.onStateChanged_(await this.browserProxy_.getState());
+    if (this.highlightedId_) {
+      await this.updateComplete;
+      this.shadowRoot.querySelector(`[data-workspace-id="${
+                           CSS.escape(this.highlightedId_)}"]`)
+          ?.scrollIntoView({block: 'center'});
+    }
+  }
+
+  private onStateChanged_(state: WorkspaceRulesState) {
+    this.state_ = state;
+    if (!state.workspaces.some(w => w.id === this.newWorkspace_)) {
+      this.newWorkspace_ = state.workspaces[0]?.id || '';
+    }
+    this.updateCheckResult_();
+  }
+
+  // Rules grouped by the workspaces of this window, then a group for
+  // workspaces of other windows if any rule points there.
+  protected getGroups_(): RuleGroup[] {
+    const groups: RuleGroup[] = this.state_.workspaces.map(workspace => ({
+      id: workspace.id,
+      label: this.workspaceLabel_(workspace),
+      highlighted: workspace.id === this.highlightedId_,
+      rules: this.state_.rules.filter(rule => rule.workspace === workspace.id),
+    }));
+    const foreign = this.state_.rules.filter(
+        rule => !this.state_.workspaces.some(w => w.id === rule.workspace));
+    if (foreign.length) {
+      groups.push({
+        id: '',
+        label: loadTimeData.getString('workspaceRulesOtherWindows'),
+        highlighted: false,
+        rules: foreign,
+      });
+    }
+    return groups;
+  }
+
+  protected workspaceLabel_(workspace: WorkspaceInfo): string {
+    return `${workspace.icon} ${workspace.name}`;
+  }
+
+  protected onEnabledChange_(e: Event) {
+    this.browserProxy_.setEnabled((e.target as CrToggleElement).checked);
+  }
+
+  protected onFollowChange_(e: Event) {
+    this.browserProxy_.setFollow((e.target as CrToggleElement).checked);
+  }
+
+  protected onRemoveClick_(e: Event) {
+    const pattern = (e.currentTarget as HTMLElement).dataset['pattern'];
+    if (pattern) {
+      this.browserProxy_.removeRule(pattern);
+    }
+  }
+
+  protected async onPatternValueChanged_(e: CustomEvent<{value: string}>) {
+    const value = e.detail.value;
+    this.newPattern_ = value;
+    const normalized =
+        value.trim() ? await this.browserProxy_.validatePattern(value) : '';
+    if (value === this.newPattern_) {
+      this.patternInvalid_ = !!value.trim() && !normalized;
+    }
+  }
+
+  protected onWorkspaceSelectChange_(e: Event) {
+    this.newWorkspace_ = (e.target as HTMLSelectElement).value;
+  }
+
+  protected canAdd_(): boolean {
+    return !!this.newPattern_.trim() && !this.patternInvalid_ &&
+        !!this.newWorkspace_;
+  }
+
+  protected async onAddClick_() {
+    if (!this.canAdd_()) {
+      return;
+    }
+    if (await this.browserProxy_.addRule(
+            this.newPattern_, this.newWorkspace_)) {
+      this.newPattern_ = '';
+    } else {
+      this.patternInvalid_ = true;
+    }
+  }
+
+  protected onPatternKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      this.onAddClick_();
+    }
+  }
+
+  protected onCheckValueChanged_(e: CustomEvent<{value: string}>) {
+    this.checkUrl_ = e.detail.value;
+    this.updateCheckResult_();
+  }
+
+  private async updateCheckResult_() {
+    const url = this.checkUrl_.trim();
+    if (!url) {
+      this.checkResult_ = '';
+      return;
+    }
+    const rule = await this.browserProxy_.matchUrl(url);
+    if (url !== this.checkUrl_.trim()) {
+      return;
+    }
+    if (!rule) {
+      this.checkResult_ = loadTimeData.getString('workspaceRulesCheckNoMatch');
+      return;
+    }
+    const workspace = this.state_.workspaces.find(w => w.id === rule.workspace);
+    this.checkResult_ = loadTimeData.getStringF(
+        'workspaceRulesCheckMatch',
+        workspace ? this.workspaceLabel_(workspace) :
+                    loadTimeData.getString('workspaceRulesAnotherWindow'),
+        rule.pattern);
+  }
+
+  // SettingsPlugin implementation
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-workspaces-page': SettingsWorkspacesPageElement;
+  }
+}
+
+customElements.define(
+    SettingsWorkspacesPageElement.is, SettingsWorkspacesPageElement);
