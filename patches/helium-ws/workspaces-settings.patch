@@ -0,0 +1,77 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+export interface WorkspaceInfo {
+  id: string;
+  name: string;
+  icon: string;
+}
+
+export interface WorkspaceRule {
+  pattern: string;
+  workspace: string;
+}
+
+export interface WorkspaceRulesState {
+  enabled: boolean;
+  follow: boolean;
+  // Workspaces of the window that shows the settings page.
+  workspaces: WorkspaceInfo[];
+  rules: WorkspaceRule[];
+}
+
+export interface WorkspacesBrowserProxy {
+  getState(): Promise<WorkspaceRulesState>;
+  setEnabled(enabled: boolean): void;
+  setFollow(follow: boolean): void;
+  // Resolves to false if `pattern` is not a valid rule.
+  addRule(pattern: string, workspaceId: string): Promise<boolean>;
+  removeRule(pattern: string): void;
+  // Resolves to the normalized pattern, or an empty string if it is invalid.
+  validatePattern(pattern: string): Promise<string>;
+  // Resolves to the rule that opens `url`, or null if none does.
+  matchUrl(url: string): Promise<WorkspaceRule|null>;
+}
+
+export class WorkspacesBrowserProxyImpl implements WorkspacesBrowserProxy {
+  getState() {
+    return sendWithPromise<WorkspaceRulesState>('getWorkspaceRules');
+  }
+
+  setEnabled(enabled: boolean) {
+    chrome.send('setWorkspaceRulesEnabled', [enabled]);
+  }
+
+  setFollow(follow: boolean) {
+    chrome.send('setWorkspaceRulesFollow', [follow]);
+  }
+
+  addRule(pattern: string, workspaceId: string) {
+    return sendWithPromise<boolean>('addWorkspaceRule', pattern, workspaceId);
+  }
+
+  removeRule(pattern: string) {
+    chrome.send('removeWorkspaceRule', [pattern]);
+  }
+
+  validatePattern(pattern: string) {
+    return sendWithPromise<string>('validateWorkspaceRulePattern', pattern);
+  }
+
+  matchUrl(url: string) {
+    return sendWithPromise<WorkspaceRule|null>('matchWorkspaceRuleUrl', url);
+  }
+
+  static getInstance(): WorkspacesBrowserProxy {
+    return instance || (instance = new WorkspacesBrowserProxyImpl());
+  }
+
+  static setInstance(obj: WorkspacesBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: WorkspacesBrowserProxy|null = null;
