+  flex-direction: column;
+  gap: 4px;
+  margin-top: 8px;
+}
+
+.add-row {
+  align-items: flex-start;
+  display: flex;
+  gap: 8px;
+}
+
+.add-row .md-select {
+  flex: none;
+  width: auto;
+}
+
+.hint {
+  min-height: 1.5em;
+}
