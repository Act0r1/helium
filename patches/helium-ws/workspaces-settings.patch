+
+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_WORKSPACES_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_WORKSPACES_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class Profile;
+
+namespace settings {
+
+// Lists the workspaces of the settings window and edits the rules that open
+// sites in a workspace.
+class WorkspacesHandler : public SettingsPageUIHandler {
+ public:
+  explicit WorkspacesHandler(Profile* profile);
+  WorkspacesHandler(const WorkspacesHandler&) = delete;
+  WorkspacesHandler& operator=(const WorkspacesHandler&) = delete;
+  ~WorkspacesHandler() override;
+
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  base::DictValue CreateState();
+  void HandleGetState(const base::ListValue& args);
+  void HandleSetEnabled(const base::ListValue& args);
+  void HandleSetFollow(const base::ListValue& args);
+  void HandleAddRule(const base::ListValue& args);
+  void HandleRemoveRule(const base::ListValue& args);
+  void HandleValidatePattern(const base::ListValue& args);
+  void HandleMatchUrl(const base::ListValue& args);
+  void OnPrefChanged();
+
+  const raw_ptr<Profile> profile_;
+  PrefChangeRegistrar pref_change_registrar_;
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_WORKSPACES_HANDLER_H_
