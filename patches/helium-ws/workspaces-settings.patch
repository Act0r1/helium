diff --git a/chrome/browser/ui/webui/settings/workspaces_handler.cc b/chrome/browser/ui/webui/settings/workspaces_handler.cc
new file mode 100644
index 000000000..56f51f12f
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/workspaces_handler.cc
@@ -0,0 +1,155 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/workspaces_handler.h"
+
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/workspaces/workspace_controller.h"
+#include "chrome/browser/ui/workspaces/workspace_rules.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_ui.h"
+#include "url/gurl.h"
+
+namespace settings {
+
+namespace {
+
+// Reads a link the way a user types it: without a scheme it is https.
+GURL ParseLink(const std::string& text) {
+  const GURL url(text);
+  if (url.is_valid() && url.has_host()) {
+    return url;
+  }
+  return GURL(base::StrCat({"https://", text}));
+}
+
+}  // namespace
+
+WorkspacesHandler::WorkspacesHandler(Profile* profile) : profile_(profile) {}
+
+WorkspacesHandler::~WorkspacesHandler() = default;
+
+void WorkspacesHandler::RegisterMessages() {
+  const auto add = [this](const char* name, auto method) {
+    web_ui()->RegisterMessageCallback(
+        name, base::BindRepeating(method, base::Unretained(this)));
+  };
+  add("getWorkspaceRules", &WorkspacesHandler::HandleGetState);
+  add("setWorkspaceRulesEnabled", &WorkspacesHandler::HandleSetEnabled);
+  add("setWorkspaceRulesFollow", &WorkspacesHandler::HandleSetFollow);
+  add("addWorkspaceRule", &WorkspacesHandler::HandleAddRule);
+  add("removeWorkspaceRule", &WorkspacesHandler::HandleRemoveRule);
+  add("validateWorkspaceRulePattern",
+      &WorkspacesHandler::HandleValidatePattern);
+  add("matchWorkspaceRuleUrl", &WorkspacesHandler::HandleMatchUrl);
+}
+
+void WorkspacesHandler::OnJavascriptAllowed() {
+  pref_change_registrar_.Init(profile_->GetPrefs());
+  for (const char* pref :
+       {prefs::kHeliumWorkspaceRules, prefs::kHeliumWorkspaceRulesEnabled,
+        prefs::kHeliumWorkspaceRulesFollow}) {
+    pref_change_registrar_.Add(
+        pref, base::BindRepeating(&WorkspacesHandler::OnPrefChanged,
+                                  base::Unretained(this)));
+  }
+}
+
+void WorkspacesHandler::OnJavascriptDisallowed() {
+  pref_change_registrar_.RemoveAll();
+}
+
+base::DictValue WorkspacesHandler::CreateState() {
+  const PrefService& prefs = *profile_->GetPrefs();
+  base::ListValue workspaces;
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  if (const auto* controller =
+          workspaces::WorkspaceController::From(browser)) {
+    for (const workspaces::Workspace& workspace : controller->GetWorkspaces()) {
+      workspaces.Append(base::DictValue()
+                            .Set("id", workspace.id)
+                            .Set("name", workspace.name)
+                            .Set("icon", workspace.icon));
+    }
+  }
+  base::ListValue rules;
+  for (const workspaces::WorkspaceRule& rule : workspaces::GetRules(prefs)) {
+    rules.Append(base::DictValue()
+                     .Set("pattern", rule.pattern)
+                     .Set("workspace", rule.workspace_id));
+  }
+  return base::DictValue()
+      .Set("enabled", prefs.GetBoolean(prefs::kHeliumWorkspaceRulesEnabled))
+      .Set("follow", prefs.GetBoolean(prefs::kHeliumWorkspaceRulesFollow))
+      .Set("workspaces", std::move(workspaces))
+      .Set("rules", std::move(rules));
+}
+
+void WorkspacesHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  ResolveJavascriptCallback(args[0], CreateState());
+}
+
+void WorkspacesHandler::HandleSetEnabled(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  profile_->GetPrefs()->SetBoolean(prefs::kHeliumWorkspaceRulesEnabled,
+                                   args[0].GetBool());
+}
+
+void WorkspacesHandler::HandleSetFollow(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  profile_->GetPrefs()->SetBoolean(prefs::kHeliumWorkspaceRulesFollow,
+                                   args[0].GetBool());
+}
+
+void WorkspacesHandler::HandleAddRule(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 3u);
+  ResolveJavascriptCallback(
+      args[0], workspaces::SetRule(*profile_->GetPrefs(), args[1].GetString(),
+                                   args[2].GetString()));
+}
+
+void WorkspacesHandler::HandleRemoveRule(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  workspaces::RemoveRule(*profile_->GetPrefs(), args[0].GetString());
+}
+
+void WorkspacesHandler::HandleValidatePattern(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  const std::optional<std::string> pattern =
+      workspaces::NormalizeRulePattern(args[1].GetString());
+  ResolveJavascriptCallback(args[0], pattern.value_or(std::string()));
+}
+
+void WorkspacesHandler::HandleMatchUrl(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  const std::optional<workspaces::WorkspaceRule> rule = workspaces::MatchRule(
+      workspaces::GetRules(*profile_->GetPrefs()),
+      ParseLink(args[1].GetString()));
+  ResolveJavascriptCallback(
+      args[0], rule ? base::Value(base::DictValue()
+                                      .Set("pattern", rule->pattern)
+                                      .Set("workspace", rule->workspace_id))
+                    : base::Value());
+}
+
+void WorkspacesHandler::OnPrefChanged() {
+  FireWebUIListener("workspace-rules-changed", CreateState());
+}
+
+}  // namespace settings
